		-- [SKIN:HIDE] RightCtrl: collapse every Dex window + the launcher into the watermark pill and back
		function Skin.SetHidden(on)
			if on == Skin.Hidden then return end
			Skin.Hidden = on
			for win in pairs(rigs) do pcall(function() win.Gui.Enabled = not on end) end
			if Lib.Window.SetSidesEnabled then pcall(Lib.Window.SetSidesEnabled, not on) end
			pcall(function() Main.MainGui.Enabled = not on end)
			if not WM.frame then buildWatermark() end
			WM.frame.Visible = on
			if on then
				updateWatermark()
				WM.scale.Scale = 0.4
				TweenService:Create(WM.scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
			end
		end

		---------------------------------------------------------------- lifecycle
		local initialised = false
		local function frame(dt)
			dt = min(dt, 1 / 15)
			cam = workspace.CurrentCamera
			if not cam then return end
			local vs = cam.ViewportSize
			V.cvx, V.cvy = vs.X, vs.Y
			V.insetY = GuiService:GetGuiInset().Y
			if cam.FieldOfView ~= V.fov then
				V.fov = cam.FieldOfView
				V.tanH = math.tan(math.rad(V.fov) / 2)
				for _, R in ipairs(rigList) do R.meshDirty, R.glassDirty = true, true end
			end
			fpsN = fpsN + 1; fpsT = fpsT + dt
			if fpsT >= 0.5 then
				fps = fpsN / fpsT
				fpsN, fpsT = 0, 0
				updateWatermark()
			end
			for _, R in ipairs(rigList) do
				local ok, err = pcall(stepRig, R, dt)
				if not ok and not R.warned then
					R.warned = true
					warn("[BAD DEX Skin] " .. tostring(err))
				end
			end
		end

		local function init()
			if initialised then return end
			initialised = true
			cam = workspace.CurrentCamera
			table.insert(conns, UIS.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch then
					lastTouch = Vector2.new(input.Position.X, input.Position.Y)
				end
			end))
			table.insert(conns, UIS.InputBegan:Connect(function(input, processed)
				if input.KeyCode == Enum.KeyCode.RightControl and not UIS:GetFocusedTextBox() then
					Skin.SetHidden(not Skin.Hidden)
				end
			end))
			RunService:BindToRenderStep("DexSkin", Enum.RenderPriority.Camera.Value + 1, frame)
		end

		-- called by Lib.Window.new for every window
		function Skin.Attach(win)
			if rigs[win] then return end
			local R = {window = win, ready = false, VX = 0, VY = 0, winX = 0, winY = 0}
			rigs[win] = R
			table.insert(rigList, R)
			applyChrome(R)
			init()
			-- the mesh itself is built lazily on the first frame the window is really visible (see stepRig)
			if not checkSupport() then R.failed = true end
		end

		function Skin.Detach(win)
			local R = rigs[win]
			if not R then return end
			rigs[win] = nil
			local i = table.find(rigList, R)
			if i then table.remove(rigList, i) end
			destroyRig(R)
		end

		function Skin.Destroy()
			pcall(function() RunService:UnbindFromRenderStep("DexSkin") end)
			for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
			conns = {}
			for win, R in pairs(rigs) do destroyRig(R) end
			if WM.gui then WM.gui:Destroy() end
		end

		return Skin
	end)()

