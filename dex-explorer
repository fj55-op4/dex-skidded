		local fps, fpsN, fpsT = 60, 0, 0
		local function updateWatermark()
			if not WM.frame or not WM.frame.Visible then return end
			local plr = Players.LocalPlayer
			local ping = 0
			pcall(function() ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
			if ping == 0 then pcall(function() ping = plr:GetNetworkPing() * 2000 end) end
			local sep = '<font color="#9aa3ad">  ·  </font>'
			WM.text.Text = "BAD DEX" .. sep .. (plr and plr.DisplayName or "Player") .. sep .. floor(fps + 0.5) .. " FPS" .. sep .. floor(ping + 0.5) .. " ms"
			local w = WM.text.TextBounds.X
			if w > 0 then
				WM.frame.Size = fromOffset(w + 42, 32)
				WM.text.Size = fromOffset(w + 10, 32)
			end
