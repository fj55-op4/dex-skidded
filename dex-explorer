local function main()
	local Spies = {}
	local window, tabBar, body
	local tabs = {}
	local currentTab

	local RunService = game:GetService("RunService")
	local ge = (getgenv and getgenv()) or _G

	---------------------------------------------------------------------
	-- Helpers
	---------------------------------------------------------------------
	-- snapshot the hook functions before Hook Spy can wrap them (our own calls must never be logged)
	local ORIG = {}
	for _, n in ipairs({"hookfunction", "hookmetamethod", "replaceclosure", "setrawmetatable", "setreadonly", "make_writeable", "restorefunction"}) do
		ORIG[n] = (env and env[n]) or ge[n]
	end

	local function G(name)
		if ORIG[name] ~= nil then return ORIG[name] end
		local v = env and env[name]
		if v ~= nil then return v end
		v = ge[name]
		if v ~= nil then return v end
		return nil
	end

	local function theme(name, fallback)
		local ok, v = pcall(function() return Settings.Theme[name] end)
		if ok and v then return v end
		return fallback
	end

	local function copyText(text)
		local f = G("setclipboard") or G("toclipboard") or G("set_clipboard")
		if f then pcall(f, text) return true end
		return false
	end

	local function nowStr() return os.date("%X") end
	local function pack(...) return {n = select("#", ...), ...} end
	local unpack = table.unpack or unpack

	local function safeComment(s)
		return (tostring(s):gsub("%]%]", "] ]"):gsub("[\r\n]+", " "))
	end

	local function traceBlock(t)
		return (tostring(t):gsub("%]%]", "] ]"):gsub("\t", "  "))
	end

	local keywords = {}
	for w in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue"):gmatch("%a+") do
		keywords[w] = true
	end

	local function validIdent(s)
		return type(s) == "string" and s:match("^[%a_][%w_]*$") ~= nil and not keywords[s]
	end

	local function esc(s)
		local r = s:gsub('[%c"\\]', function(c)
			if c == '"' then return '\\"'
			elseif c == "\\" then return "\\\\"
			elseif c == "\n" then return "\\n"
			elseif c == "\r" then return "\\r"
			elseif c == "\t" then return "\\t" end
			return string.format("\\%03d", c:byte())
		end)
		return '"' .. r .. '"'
	end

	local function nameKey(name)
		if validIdent(name) then return "." .. name end
		return "[" .. esc(name) .. "]"
	end

	local function isService(inst)
		local ok, res = pcall(function() return game:GetService(inst.ClassName) == inst end)
		return ok and res
	end

	local function pathOf(inst)
		if inst == nil then return "nil" end
		if inst == game then return "game" end
		local chain = {}
		local cur = inst
		local guard = 0
		while cur and cur ~= game and guard < 100 do
			table.insert(chain, 1, cur)
			cur = cur.Parent
			guard = guard + 1
		end
		if cur ~= game then
			return "nil --[[ nil-parented: " .. safeComment(inst.Name) .. " (" .. inst.ClassName .. ") ]]"
		end
		local out
		local startIdx = 1
		local lp = plr
		if lp and chain[1] == game:GetService("Players") and chain[2] == lp then
			out = 'game:GetService("Players").LocalPlayer'
			startIdx = 3
		elseif isService(chain[1]) then
			out = 'game:GetService(' .. esc(chain[1].ClassName) .. ')'
			startIdx = 2
		else
			out = "game" .. nameKey(chain[1].Name)
			startIdx = 2
		end
		for i = startIdx, #chain do
			out = out .. nameKey(chain[i].Name)
		end
		return out
	end

	-- [SPIES:SERIALIZE] value -> Lua source text (Vector3, CFrame, Instances, tables, ...). Add new types in serialize().
	local serialize
	local function serializeTable(t, indent, seen, depth)
		if seen[t] then return "{} --[[ cyclic ]]" end
		if depth > 6 then return "{} --[[ max depth ]]" end
		seen[t] = true
		local out = {}
		local pad = string.rep("\t", indent + 1)
		local okn, n = pcall(function() return #t end)
		if not okn then n = 0 end
		local limit = 150
		for i = 1, n do
			if #out >= limit then out[#out + 1] = pad .. "-- ... truncated" break end
			out[#out + 1] = pad .. serialize(rawget(t, i), indent + 1, seen, depth + 1)
		end
		local okp = pcall(function()
			for k, v in next, t do
				if #out >= limit then out[#out + 1] = pad .. "-- ... truncated" break end
				if not (type(k) == "number" and k >= 1 and k <= n and k % 1 == 0) then
					local ks
					if validIdent(k) then ks = k
					else ks = "[" .. serialize(k, indent + 1, seen, depth + 1) .. "]" end
					out[#out + 1] = pad .. ks .. " = " .. serialize(v, indent + 1, seen, depth + 1)
				end
			end
		end)
		seen[t] = nil
		if #out == 0 then return "{}" end
		return "{\n" .. table.concat(out, ",\n") .. "\n" .. string.rep("\t", indent) .. "}"
	end

	local function fnName(f)
		local getinfo = (debug and debug.getinfo) or G("getinfo")
		local nm = "unknown"
		if getinfo then
			local ok, info = pcall(getinfo, f)
			if ok and info then
				nm = (info.name and info.name ~= "" and info.name) or nm
			end
		end
		return nm
	end

	serialize = function(v, indent, seen, depth)
		indent = indent or 0
		seen = seen or {}
		depth = depth or 0
		local tv = typeof(v)
		if tv == "string" then
			return esc(v)
		elseif tv == "number" then
			if v ~= v then return "0/0 --[[ nan ]]"
			elseif v == math.huge then return "math.huge"
			elseif v == -math.huge then return "-math.huge"
			elseif v % 1 == 0 and math.abs(v) < 1e15 then return string.format("%d", v) end
			return string.format("%.14g", v)
		elseif tv == "boolean" or tv == "nil" then
			return tostring(v)
		elseif tv == "table" then
			return serializeTable(v, indent, seen, depth)
		elseif tv == "Instance" then
			return pathOf(v)
		elseif tv == "function" then
			return "function() end --[[ " .. safeComment(fnName(v)) .. " ]]"
		elseif tv == "Vector3" then
			return string.format("Vector3.new(%s, %s, %s)", serialize(v.X), serialize(v.Y), serialize(v.Z))
		elseif tv == "Vector2" then
			return string.format("Vector2.new(%s, %s)", serialize(v.X), serialize(v.Y))
		elseif tv == "CFrame" then
			local comps = {v:GetComponents()}
			for i = 1, #comps do comps[i] = serialize(comps[i]) end
			return "CFrame.new(" .. table.concat(comps, ", ") .. ")"
		elseif tv == "Color3" then
			return string.format("Color3.new(%s, %s, %s)", serialize(v.R), serialize(v.G), serialize(v.B))
		elseif tv == "UDim2" then
			return string.format("UDim2.new(%s, %s, %s, %s)", serialize(v.X.Scale), serialize(v.X.Offset), serialize(v.Y.Scale), serialize(v.Y.Offset))
		elseif tv == "UDim" then
			return string.format("UDim.new(%s, %s)", serialize(v.Scale), serialize(v.Offset))
		elseif tv == "EnumItem" or tv == "Enum" then
			return tostring(v)
		elseif tv == "BrickColor" then
			return "BrickColor.new(" .. esc(v.Name) .. ")"
		elseif tv == "NumberRange" then
			return string.format("NumberRange.new(%s, %s)", serialize(v.Min), serialize(v.Max))
		elseif tv == "Rect" then
			return string.format("Rect.new(%s, %s, %s, %s)", serialize(v.Min.X), serialize(v.Min.Y), serialize(v.Max.X), serialize(v.Max.Y))
		elseif tv == "Ray" then
			return string.format("Ray.new(%s, %s)", serialize(v.Origin), serialize(v.Direction))
		elseif tv == "TweenInfo" then
			return string.format("TweenInfo.new(%s, %s, %s)", serialize(v.Time), tostring(v.EasingStyle), tostring(v.EasingDirection))
		end
		return "nil --[[ " .. safeComment(tv) .. ": " .. safeComment(tostring(v)) .. " ]]"
	end

	local function serializeArgs(args)
		local parts = {}
		for i = 1, args.n do
			local ok, s = pcall(serialize, args[i], 0, {}, 0)
			parts[i] = ok and s or ("nil --[[ serialize error: " .. safeComment(s) .. " ]]")
		end
		return parts
	end

	-- [SPIES:CODEGEN] turns a captured remote call into a runnable snippet (shown in Cobalt details; UtopiaSpy has its own generator, see [SPIES:UTOPIA-CODEGEN])
	-- Generates a runnable snippet for a remote call
	local function genRemoteCode(e)
		local lines = {}
		local dirText = e.dir == "in" and "Server -> Client" or "Client -> Server"
		lines[#lines + 1] = "-- " .. dirText .. " | " .. safeComment(e.class) .. " | " .. e.clock
		lines[#lines + 1] = "local remote = " .. pathOf(e.remote)
		local exprs = serializeArgs(e.args)
		local callArgs = {}
		for i = 1, e.args.n do
			if exprs[i]:find("\n", 1, true) or #exprs[i] > 90 then
				lines[#lines + 1] = "local arg" .. i .. " = " .. exprs[i]
				callArgs[i] = "arg" .. i
			else
				callArgs[i] = exprs[i]
			end
		end
		local argStr = table.concat(callArgs, ", ")
		if e.dir == "in" then
			lines[#lines + 1] = ""
			lines[#lines + 1] = "-- replay the incoming call on the client (needs firesignal):"
			lines[#lines + 1] = "firesignal(remote.OnClientEvent" .. (argStr ~= "" and (", " .. argStr) or "") .. ")"
		else
			lines[#lines + 1] = ""
			lines[#lines + 1] = "remote:" .. e.method .. "(" .. argStr .. ")"
		end
		return table.concat(lines, "\n")
	end

	---------------------------------------------------------------------
	-- UI building blocks
	---------------------------------------------------------------------
	local C = {
		Main1 = function() return theme("Main1", Color3.fromRGB(37, 37, 37)) end,
		Main2 = function() return theme("Main2", Color3.fromRGB(46, 46, 46)) end,
		Text = function() return theme("Text", Color3.fromRGB(230, 230, 230)) end,
		Button = function() return theme("Button", Color3.fromRGB(60, 60, 60)) end,
		Hover = function() return theme("ButtonHover", Color3.fromRGB(80, 80, 80)) end,
		Sel = function() return theme("ListSelection", Color3.fromRGB(11, 90, 175)) end,
	}
	local COL_OUT = Color3.fromRGB(130, 190, 255)
	local COL_IN = Color3.fromRGB(140, 230, 150)
	local COL_BLOCK = Color3.fromRGB(240, 110, 110)
	local COL_WARN = Color3.fromRGB(240, 200, 110)

	local function mkButton(parent, text, width, onClick)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, width, 0, 20)
		b.BackgroundColor3 = C.Button()
		b.BorderSizePixel = 0
		b.TextColor3 = C.Text()
		b.Font = Enum.Font.SourceSans
		b.TextSize = 14
		b.AutoButtonColor = true
		b.Text = text
		b.Parent = parent
		b.MouseButton1Click:Connect(function()
			local ok, err = pcall(onClick, b)
			if not ok then warn("[BAD DEX Spies] " .. tostring(err)) end
		end)
		return b
	end

	local function mkBox(parent, placeholder, width)
		local t = Instance.new("TextBox")
		t.Size = UDim2.new(0, width, 0, 20)
		t.BackgroundColor3 = theme("TextBox", Color3.fromRGB(25, 25, 25))
		t.BorderSizePixel = 0
		t.TextColor3 = C.Text()
		t.PlaceholderText = placeholder
		t.PlaceholderColor3 = theme("PlaceholderText", Color3.fromRGB(120, 120, 120))
		t.Font = Enum.Font.SourceSans
		t.TextSize = 14
		t.Text = ""
		t.ClearTextOnFocus = false
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Parent = parent
		return t
	end

	-- [SPIES:PANEL] makePanel() builds a tab: toolbar buttons/boxes + log list + detail box.
	-- A panel = toolbar + log list (left) + detail box (right)
	-- cfg.buttons = { {text, width, fn(btn, panel)} ... }, cfg.boxes = { {placeholder, width, key} ... }
	local MAX_ROWS = 400
	local function makePanel(cfg)
		local P = {rows = {}, counter = 0, boxes = {}, selected = nil}

		local frame = Instance.new("Frame")
		frame.Name = cfg.name
		frame.BackgroundTransparency = 1
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.Visible = false
		frame.Parent = body
		P.Frame = frame

		local toolbar = Instance.new("ScrollingFrame")
		toolbar.BackgroundColor3 = C.Main2()
		toolbar.BorderSizePixel = 0
		toolbar.Size = UDim2.new(1, 0, 0, 44)
		toolbar.ScrollBarThickness = 3
		toolbar.CanvasSize = UDim2.new(0, 0, 0, 0)
		toolbar.AutomaticCanvasSize = Enum.AutomaticSize.Y
		toolbar.ScrollingDirection = Enum.ScrollingDirection.Y
		toolbar.Parent = frame
		local tl = Instance.new("UIListLayout")
		tl.FillDirection = Enum.FillDirection.Horizontal
		tl.Wraps = true
		tl.Padding = UDim.new(0, 3)
		tl.SortOrder = Enum.SortOrder.LayoutOrder
		tl.Parent = toolbar
		local tp = Instance.new("UIPadding")
		tp.PaddingLeft = UDim.new(0, 3)
		tp.PaddingTop = UDim.new(0, 2)
		tp.Parent = toolbar

		for _, bx in ipairs(cfg.boxes or {}) do
			P.boxes[bx[3]] = mkBox(toolbar, bx[1], bx[2])
		end
		for _, bt in ipairs(cfg.buttons or {}) do
			local b
			b = mkButton(toolbar, bt[1], bt[2], function() bt[3](b, P) end)
			if bt[4] then bt[4](b, P) end
		end

		local list = Instance.new("ScrollingFrame")
		list.BackgroundColor3 = C.Main1()
		list.BorderSizePixel = 0
		list.Position = UDim2.new(0, 0, 0, 46)
		list.Size = UDim2.new(0.42, -2, 1, -46)
		list.ScrollBarThickness = 8
		list.CanvasSize = UDim2.new(0, 0, 0, 0)
		list.AutomaticCanvasSize = Enum.AutomaticSize.Y
		list.Parent = frame
		local ll = Instance.new("UIListLayout")
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = list
		P.List = list

		local detail = Instance.new("TextBox")
		detail.BackgroundColor3 = C.Main1()
		detail.BorderSizePixel = 0
		detail.Position = UDim2.new(0.42, 0, 0, 46)
		detail.Size = UDim2.new(0.58, 0, 1, -46)
		detail.TextColor3 = C.Text()
		detail.Font = Enum.Font.Code
		detail.TextSize = 13
		detail.TextXAlignment = Enum.TextXAlignment.Left
		detail.TextYAlignment = Enum.TextYAlignment.Top
		detail.ClearTextOnFocus = false
		detail.MultiLine = true
		detail.TextWrapped = false
		detail.Text = cfg.hint or ""
		detail.Parent = frame
		P.Detail = detail

		function P.setDetail(text)
			if #text > 60000 then text = text:sub(1, 60000) .. "\n-- ... output truncated" end
			detail.Text = text
		end

		function P.addRow(text, color, data, onSelect)
			P.counter = P.counter + 1
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 18)
			btn.BackgroundColor3 = C.Main1()
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = false
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 14
			btn.TextColor3 = color or C.Text()
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.TextTruncate = Enum.TextTruncate.AtEnd
			btn.Text = " " .. text
			btn.LayoutOrder = cfg.oldestFirst and P.counter or -P.counter
			btn.Parent = list
			local row = {Button = btn, Data = data, Color = color}
			P.rows[#P.rows + 1] = row
			btn.MouseButton1Click:Connect(function()
				if P.selected then P.selected.Button.BackgroundColor3 = C.Main1() end
				P.selected = row
				btn.BackgroundColor3 = C.Sel()
				if onSelect then
					local ok, err = pcall(onSelect, row)
					if not ok then P.setDetail("-- error while rendering details:\n" .. tostring(err)) end
				end
			end)
			if #P.rows > MAX_ROWS then
				local old = table.remove(P.rows, 1)
				if P.selected == old then P.selected = nil end
				old.Button:Destroy()
			end
			return row
		end

		function P.clear()
			for _, r in ipairs(P.rows) do r.Button:Destroy() end
			P.rows = {}
			P.selected = nil
			detail.Text = ""
		end

		function P.setRowColor(row, color)
			row.Color = color
			row.Button.TextColor3 = color or C.Text()
		end

		return P
	end

	local function addTab(name, buildFn)
		local t = {Name = name}
		tabs[#tabs + 1] = t
		local idx = #tabs
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1 / 7, -2, 1, 0)
		b.BackgroundColor3 = C.Button()
		b.BorderSizePixel = 0
		b.TextColor3 = C.Text()
		b.Font = Enum.Font.SourceSansBold
		b.TextSize = 14
		b.Text = name
		b.LayoutOrder = idx
		b.Parent = tabBar
		t.Button = b
		t.Panel = buildFn()
		b.MouseButton1Click:Connect(function() Spies.SelectTab(idx) end)
		return t
	end

	Spies.SelectTab = function(idx)
		for i, t in ipairs(tabs) do
			local on = i == idx
			t.Panel.Frame.Visible = on
			t.Button.BackgroundColor3 = on and C.Sel() or C.Button()
		end
		currentTab = idx
	end

	---------------------------------------------------------------------
	-- Event queue (decouples hooks from UI work)
	---------------------------------------------------------------------
	local queue = {}
	local function push(fn)
		if #queue < 2000 then queue[#queue + 1] = fn end
	end
	local queueCon
	local function startQueue()
		if queueCon then return end
		queueCon = RunService.Heartbeat:Connect(function()
			local n = 0
			while #queue > 0 and n < 12 do
				local fn = table.remove(queue, 1)
				local ok, err = pcall(fn)
				if not ok then warn("[BAD DEX Spies] " .. tostring(err)) end
				n = n + 1
			end
		end)
	end

	---------------------------------------------------------------------
	-- UtopiaSpy logic (replaces the SimpleSpy tab)
	--
	-- Port of the UtopiaSpy script's code generator: get_path / get_real_value / table_to_string /
	-- convert_to_code / convert_to_code_client, with the same settings table and the same output
	-- style (`Remote:FireServer(table.unpack({...}))`, `--[[function -->]]` dumps with upvalues,
	-- constants, protos and info, `utf8.char(...)` for odd instance names, ...).
	-- The hooks themselves (namecall / FireServer / InvokeServer / OnClientEvent / OnClientInvoke)
	-- live in the shared remote engine below.
	--
	-- [SPIES:UTOPIA] tunables - edit these values to taste:
	---------------------------------------------------------------------
	local Utopia = {
		maxTableDepth = 100,       -- same default as UtopiaSpy: deeper tables become "table_over_maxTableDepth"
		maxTableEntries = 6000,    -- extra safety: stop dumping one value after this many entries
		newFunctionMethod = true,  -- true: dump Lua functions as upvalues/constants/protos/info; false: "function() end"
		blacklistedNames = {},     -- remote NAMES that are never shown, e.g. {"Heartbeat", "UpdateCamera"}
		invokeClientHook = true,   -- hook OnClientInvoke callbacks (needs getcallbackmember + hookfunction)
	}
	Spies.Utopia = Utopia
	local utopiaDepth, utopiaCount = 0, 0
	local utopiaPath, utopiaValue

	local function utopiaUtf8(s)
		local parts = {}
		local ok = pcall(function() for _, c in utf8.codes(s) do parts[#parts + 1] = tostring(c) end end)
		if not ok then return esc(s) end
		return "utf8.char(" .. table.concat(parts, ", ") .. ")"
	end

	local function utopiaEscape(s)
		return (s:gsub("\\", "\\\\"):gsub("\0", "\\0"):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
			:gsub("\v", "\\v"):gsub("\b", "\\b"):gsub("\f", "\\f"))
	end

	-- get_path: instance -> Lua expression
	utopiaPath = function(inst)
		local name = inst.Name
		local seg = (#name > 0) and ("." .. name) or "['']"
		if not inst.Parent and inst ~= game then return seg .. " --[[ Parented to nil ]]" end
		if inst == game then return "game" end
		if inst == workspace then return "workspace" end
		local okSvc, svc = pcall(game.GetService, game, inst.ClassName)
		local part
		local strippedWord = name:gsub("[%w_]", "")
		if okSvc and svc then
			part = ':GetService("' .. inst.ClassName .. '")'
		elseif inst == plr then
			part = ".LocalPlayer"
		elseif tonumber(name:sub(1, 1)) or (#strippedWord ~= 0 and #(strippedWord:gsub("[%s%p]", "")) == 0) then
			part = '["' .. name:gsub("\\", "\\\\"):gsub('"', '\\"') .. '"]'
		elseif #strippedWord ~= 0 and #(strippedWord:gsub("[%s%p]", "")) > 0 then
			part = "[" .. utopiaUtf8(name) .. "]"
		else
			part = seg
		end
		return utopiaPath(inst.Parent) .. part
	end

	local function utopiaTable(t, seen)
		utopiaDepth = utopiaDepth + 1
		local depth = utopiaDepth
		if Utopia.maxTableDepth + 1 < depth then
			utopiaDepth = utopiaDepth - 1
			return "table_over_maxTableDepth (.." .. tostring(t) .. ")"
		end
		if seen[t] then
			utopiaDepth = utopiaDepth - 1
			return "{} --[[ cyclic: " .. safeComment(tostring(t)) .. " ]]"
		end
		seen[t] = true
		local pad = ("    "):rep(depth)
		local out = {"{"}
		local ok = pcall(function()
			for k, v in next, t do
				utopiaCount = utopiaCount + 1
				if utopiaCount > Utopia.maxTableEntries then
					out[#out + 1] = "\n" .. pad .. "--[[ truncated: maxTableEntries reached ]]"
					break
				end
				out[#out + 1] = "\n" .. pad .. "[" .. utopiaValue(k, seen) .. "] = " .. utopiaValue(v, seen) .. ","
			end
		end)
		if not ok then out[#out + 1] = "\n" .. pad .. "--[[ table could not be iterated ]]" end
		seen[t] = nil
		utopiaDepth = utopiaDepth - 1
		return table.concat(out) .. "\n" .. ("    "):rep(utopiaDepth) .. "}"
	end

	local function utopiaFnInfo(f)
		local getinfo = (debug and debug.getinfo) or G("getinfo")
		local info = {}
		if getinfo then
			local ok, res = pcall(getinfo, f)
			if ok and type(res) == "table" then
				for k, v in pairs(res) do if k ~= "func" then info[k] = v end end
			end
		end
		return info
	end

	local function utopiaFnDump(f)
		local dbg = debug or {}
		local function try(...)
			for i = 1, select("#", ...) do
				local fn = select(i, ...)
				if type(fn) == "function" then
					local ok, res = pcall(fn, f)
					if ok then return res end
				end
			end
		end
		return {
			upvalues = try(dbg.getupvalues, G("getupvalues")),
			constants = try(dbg.getconstants, G("getconstants")),
			protos = try(dbg.getprotos, G("getprotos")),
			info = utopiaFnInfo(f),
		}
	end

	local NORMAL_TYPES = {UDim2 = true, UDim = true, Vector3 = true, Vector2 = true, CFrame = true, Vector2int16 = true,
		Vector3int16 = true, BrickColor = true, Color3 = true}

	-- get_real_value: any value -> Lua expression text
	utopiaValue = function(v, seen)
		seen = seen or {}
		local tv = typeof(v)
		if tv == "Instance" then return utopiaPath(v) end
		if tv == "string" then return '"' .. utopiaEscape(v) .. '"' end
		if tv == "table" then return utopiaTable(v, seen) end
		if tv == "function" then
			local isL = G("islclosure")
			if isL and isL(v) then
				if Utopia.newFunctionMethod then
					return "--[[function -->]] " .. utopiaTable(utopiaFnDump(v), seen)
				end
				return "function() end"
			end
			return "newcclosure(function() end)"
		end
		if tv == "number" then
			if v ~= v then return "0/0" elseif v == math.huge then return "math.huge" elseif v == -math.huge then return "-math.huge" end
			return tostring(v)
		end
		if tv == "UDim2" then
			return "UDim2.new(" .. tostring(v.X.Scale) .. ", " .. tostring(v.X.Offset) .. ", " .. tostring(v.Y.Scale) .. ", " .. tostring(v.Y.Offset) .. ")"
		end
		if NORMAL_TYPES[tv] then
			local inner = tv == "BrickColor" and ("'" .. tostring(v) .. "'") or tostring(v)
			return tv .. ".new(" .. inner .. ")"
		end
		if tv == "TweenInfo" then
			return "TweenInfo.new(" .. utopiaValue(v.Time) .. ", " .. utopiaValue(v.EasingStyle) .. ", " .. utopiaValue(v.EasingDirection)
				.. ", " .. utopiaValue(v.RepeatCount) .. ", " .. utopiaValue(v.Reverses) .. ", " .. utopiaValue(v.DelayTime) .. ")"
		end
		if tv == "Enums" then return "Enum" end
		if tv == "Enum" then return "Enum." .. tostring(v) end
		if tv == "EnumItem" then return tostring(v) end
		if tv == "Axes" or tv == "Faces" then
			local parts = {}
			for _, item in ipairs(Enum.NormalId:GetEnumItems()) do
				if v[item.Name] then parts[#parts + 1] = utopiaValue(item) end
			end
			return tv .. ".new(" .. table.concat(parts, ", ") .. ")"
		end
		if tv == "ColorSequence" or tv == "NumberSequence" then
			local parts = {}
			for _, kp in ipairs(v.Keypoints) do parts[#parts + 1] = utopiaValue(kp) end
			return tv .. ".new{" .. table.concat(parts, ", ") .. "}"
		end
		if tv == "ColorSequenceKeypoint" then return "ColorSequenceKeypoint.new(" .. tostring(v.Time) .. ", " .. utopiaValue(v.Value) .. ")" end
		if tv == "NumberSequenceKeypoint" then
			return "NumberSequenceKeypoint.new(" .. tostring(v.Time) .. ", " .. utopiaValue(v.Value) .. (v.Envelope and (", " .. v.Envelope) or "") .. ")"
		end
		if tv == "DateTime" then
			if v.UnixTimestampMillis == DateTime.now().UnixTimestampMillis then return "DateTime.now()" end
			return "DateTime.fromUnixTimestampMillis(" .. v.UnixTimestampMillis .. ")"
		end
		if tv == "FloatCurveKey" then return "FloatCurveKey.new(" .. utopiaValue(v.Time) .. ", " .. utopiaValue(v.Value) .. ", " .. utopiaValue(v.Interpolation) .. ")" end
		if tv == "NumberRange" then return "NumberRange.new(" .. utopiaValue(v.Min) .. ", " .. utopiaValue(v.Max) .. ")" end
		if tv == "PathWaypoint" then return "PathWaypoint.new(" .. utopiaValue(v.Position) .. ", " .. utopiaValue(v.Action) .. ")" end
		if tv == "PhysicalProperties" then
			return "PhysicalProperties.new(" .. utopiaValue(v.Density) .. ", " .. utopiaValue(v.Friction) .. ", " .. utopiaValue(v.Elasticity)
				.. ", " .. utopiaValue(v.FrictionWeight) .. ", " .. utopiaValue(v.ElasticityWeight) .. ")"
		end
		if tv == "Random" then return "Random.new()" end
		if tv == "Ray" then return "Ray.new(" .. utopiaValue(v.Origin) .. ", " .. utopiaValue(v.Direction) .. ")" end
		if tv == "RaycastParams" then
			return "--[[typeof: RaycastParams ->]] {FilterDescendantsInstances = " .. utopiaValue(v.FilterDescendantsInstances) .. ", FilterType = "
				.. utopiaValue(v.FilterType) .. ", IgnoreWater = " .. utopiaValue(v.IgnoreWater) .. ", CollisionGroup = '" .. tostring(v.CollisionGroup) .. "'}"
		end
		if tv == "RaycastResult" then
			return "--[[typeof: RaycastResult ->]] {Distance = " .. utopiaValue(v.Distance) .. ", Instance = " .. utopiaValue(v.Instance)
				.. ", Material = " .. utopiaValue(v.Material) .. ", Position = " .. utopiaValue(v.Position) .. ", Normal = " .. utopiaValue(v.Normal) .. "}"
		end
		if tv == "RBXScriptConnection" then return "--[[typeof: RBXScriptConnection ->]] {Connected = " .. utopiaValue(v.Connected) .. "}" end
		if tv == "RBXScriptSignal" then return "RBXScriptSignal" end
		if tv == "Rect" then return "Rect.new(" .. utopiaValue(v.Min) .. ", " .. utopiaValue(v.Max) .. ")" end
		if tv == "Region3" then
			local cf, sz = v.CFrame, v.Size
			return "Region3.new(" .. utopiaValue((cf * CFrame.new(-sz.X / 2, -sz.Y / 2, -sz.Z / 2)).p) .. ", "
				.. utopiaValue((cf * CFrame.new(sz.X / 2, sz.Y / 2, sz.Z / 2)).p) .. ")"
		end
		if tv == "Region3int16" then return "Region3int16.new(" .. utopiaValue(v.Min) .. ", " .. utopiaValue(v.Max) .. ")" end
		if tv == "OverlapParams" then
			return "--[[typeof: OverlapParams ->]] {FilterDescendantsInstances = " .. utopiaValue(v.FilterDescendantsInstances) .. ", FilterType = "
				.. utopiaValue(v.FilterType) .. ", MaxParts =" .. utopiaValue(v.MaxParts) .. ", CollisionGroup = " .. utopiaValue(v.CollisionGroup) .. "}"
		end
		if tv == "userdata" then return "newproxy(true)" end
		if v == nil then return "nil" end
		return tostring(v)
	end

	local function utopiaGuard(f, ...)
		utopiaDepth, utopiaCount = 0, 0
		local ok, res = pcall(f, ...)
		utopiaDepth, utopiaCount = 0, 0
		if ok then return res end
		return "nil --[[ UtopiaSpy: could not serialize: " .. safeComment(res) .. " ]]"
	end

	-- the recorded args table (pack(...)) as a `table.unpack({...}, 1, n)` argument
	local function utopiaArgsTable(args)
		local rows = {"{"}
		for i = 1, args.n do
			rows[#rows + 1] = "\n    [" .. i .. "] = " .. utopiaGuard(utopiaValue, args[i]) .. ","
		end
		return table.concat(rows) .. "\n}"
	end

	-- convert_to_code (outgoing: FireServer / InvokeServer)
	local function utopiaOut(remote, args, method)
		local r = utopiaGuard(utopiaValue, remote)
		if args.n == 0 then return r .. ":" .. method .. "()" end
		if args.n == 1 then return r .. ":" .. method .. "(" .. utopiaGuard(utopiaValue, args[1]) .. ")" end
		return r .. ":" .. method .. "(table.unpack(" .. utopiaArgsTable(args) .. ", 1, " .. args.n .. "))"
	end

	-- convert_to_code_client (incoming: FireClient / InvokeClient)
	local function utopiaIn(remote, args, method)
		local r = utopiaGuard(utopiaValue, remote)
		local lm = method:lower()
		local a
		if args.n == 0 then a = ""
		elseif args.n == 1 then a = utopiaGuard(utopiaValue, args[1])
		else a = "table.unpack(" .. utopiaArgsTable(args) .. ", 1, " .. args.n .. ")" end
		if lm == "fireclient" or lm == "onclientevent" then
			return "local Remote = " .. r .. "\nfiresignal(Remote.OnClientEvent" .. (a ~= "" and (", " .. a) or "") .. ")"
		elseif lm == "invokeclient" then
			return "local Remote = " .. r .. '\nlocal callback = getcallbackmember(Remote, "OnClientInvoke")\ncallback(' .. a .. ")"
		end
		return "-- Unknown ncm for client: " .. method
	end

	-- [SPIES:UTOPIA-CODEGEN] entry point used by the UtopiaSpy tab (Copy Code / detail view)
	local function utopiaCode(e)
		if e.dir == "in" then return utopiaIn(e.remote, e.args, e.method) end
		return utopiaOut(e.remote, e.args, e.method)
	end

	---------------------------------------------------------------------
	-- Remote engine (shared by UtopiaSpy + Cobalt)
	---------------------------------------------------------------------
	local Remote = {
		installed = false,
		simple = false, cobalt = false,
		incoming = true, bindables = false, trace = true,
		blocked = {}, simpleIgnored = {}, cobaltIgnored = {},
		inCall = setmetatable({}, {__mode = "k"}),
		incomingCons = {}, incomingConnected = false, cbHooked = setmetatable({}, {__mode = "k"}),
		counter = 0,
	}
	local OUT = {FireServer = true, fireServer = true, InvokeServer = true, invokeServer = true}
	local OUTB = {Fire = true, fire = true, Invoke = true, invoke = true}
	local REMOTE_CLASSES = {RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true}
	local BIND_CLASSES = {BindableEvent = true, BindableFunction = true}

	local function classifyCall(obj, method)
		local ok, cn = pcall(function() return obj.ClassName end)
		if not ok or type(cn) ~= "string" then return nil end
		if REMOTE_CLASSES[cn] and OUT[method] then return cn end
		if Remote.bindables and BIND_CLASSES[cn] and OUTB[method] then return cn end
		return nil
	end

	local dispatchRemote -- defined after panels exist

	local function recordRemote(dir, remote, cn, method, args)
		Remote.counter = Remote.counter + 1
		local e = {
			id = Remote.counter, dir = dir, remote = remote, name = remote.Name,
			class = cn, method = method, args = args, clock = nowStr(),
		}
		if dir ~= "in" then
			local gcs = G("getcallingscript")
			if gcs then
				local ok, s = pcall(gcs)
				if ok then e.script = s end
			end
			if Remote.cobalt and Remote.trace then
				e.trace = debug.traceback("", 3)
			end
		end
		e.blocked = Remote.blocked[remote] == true
		push(function() dispatchRemote(e) end)
		return e
	end

	local function installRemote()
		if Remote.installed then return true end
		local hookmm, getnc = G("hookmetamethod"), G("getnamecallmethod")
		if not (hookmm and getnc) then
			return false, "executor lacks hookmetamethod / getnamecallmethod"
		end
		local setnc = G("setnamecallmethod")
		local newcc = G("newcclosure") or function(f) return f end
		local checkcaller = G("checkcaller") or function() return false end

		-- [SPIES:REMOTE-HOOK] called for EVERY FireServer / InvokeServer (namecall and direct form).
		-- This is the place to add your own logic: filter/rewrite `...` before oldFn(self, ...),
		-- change what gets recorded (recordRemote), or decide what is blocked (Remote.blocked).
		local function handle(oldFn, isNC, self, method, ...)
			if isNC and setnc then setnc(method) end
			local co = coroutine.running()
			if Remote.inCall[co] or checkcaller() then return oldFn(self, ...) end
			local cn = classifyCall(self, method)
			if not cn then
				if isNC and setnc then setnc(method) end
				return oldFn(self, ...)
			end
			local e = recordRemote("out", self, cn, method, pack(...))
			if e.blocked then return nil end
			Remote.inCall[co] = true
			push(function() Remote.inCall[co] = nil end)
			if isNC and setnc then setnc(method) end
			local r = pack(oldFn(self, ...))
			Remote.inCall[co] = nil
			e.ret = r
			return unpack(r, 1, r.n)
		end

		-- [SPIES:NAMECALL-HOOK] the single global __namecall hook used by UtopiaSpy + Cobalt tabs.
		-- How it is installed (hookmetamethod, newcclosure wrapper) is decided here.
		local oldNC
		oldNC = hookmm(game, "__namecall", newcc(function(self, ...)
			local method = getnc()
			if (Remote.simple or Remote.cobalt) and type(method) == "string" and (OUT[method] or OUTB[method]) then
				return handle(oldNC, true, self, method, ...)
			end
			return oldNC(self, ...)
		end))

		-- [SPIES:DIRECT-HOOK] direct calls: remote.FireServer(remote, ...)
		local hookf = G("hookfunction")
		if hookf then
			local function hookDirect(className, method)
				local ok, err = pcall(function()
					local inst = Instance.new(className)
					local f = inst[method]
					inst:Destroy()
					local old
					old = hookf(f, newcc(function(self, ...)
						if Remote.simple or Remote.cobalt then
							return handle(old, false, self, method, ...)
						end
						return old(self, ...)
					end))
				end)
				if not ok then warn("[BAD DEX Spies] direct hook " .. className .. "." .. method .. " failed: " .. tostring(err)) end
			end
			hookDirect("RemoteEvent", "FireServer")
			hookDirect("RemoteFunction", "InvokeServer")
			pcall(hookDirect, "UnreliableRemoteEvent", "FireServer")
			pcall(hookDirect, "BindableEvent", "Fire")
			pcall(hookDirect, "BindableFunction", "Invoke")
		end

		Remote.installed = true
		startQueue()
		return true
	end

	local function incomingWanted(r)
		if not Remote.incoming then return false end
		return (Remote.cobalt and not Remote.cobaltIgnored[r]) or (Remote.simple and not Remote.simpleIgnored[r]) or false
	end

	-- [SPIES:UTOPIA-CLIENTINVOKE] logs server -> client RemoteFunction calls (OnClientInvoke) like UtopiaSpy does.
	-- Needs getcallbackmember + hookfunction; switch off with Spies.Utopia.invokeClientHook = false.
	local function hookClientInvoke(rf)
		local gcm, hookf = G("getcallbackmember"), G("hookfunction")
		if not (Utopia.invokeClientHook and gcm and hookf) then return end
		local newcc = G("newcclosure") or function(f) return f end
		local function hookCb()
			local ok, cb = pcall(gcm, rf, "OnClientInvoke")
			if not ok or type(cb) ~= "function" or Remote.cbHooked[cb] then return end
			local old
			local ok2, res = pcall(hookf, cb, newcc(function(...)
				if Remote.simple and Remote.incoming then
					recordRemote("in", rf, rf.ClassName, "InvokeClient", pack(...))
				end
				return old(...)
			end))
			if ok2 then old = res Remote.cbHooked[cb] = true end
		end
		hookCb()
		local okc, con = pcall(function() return rf:GetPropertyChangedSignal("OnClientInvoke"):Connect(hookCb) end)
		if okc and con then table.insert(Remote.incomingCons, con) end
	end

	local function connectIncoming()
		if Remote.incomingConnected then return end
		Remote.incomingConnected = true
		local function hookRemote(r)
			local ok, con = pcall(function()
				return r.OnClientEvent:Connect(function(...)
					if incomingWanted(r) then
						recordRemote("in", r, r.ClassName, "OnClientEvent", pack(...))
					end
				end)
			end)
			if ok and con then table.insert(Remote.incomingCons, con) end
		end
		for _, d in ipairs(game:GetDescendants()) do
			if d:IsA("BaseRemoteEvent") then hookRemote(d)
			elseif d.ClassName == "RemoteFunction" then pcall(hookClientInvoke, d) end
		end
		Remote.descCon = game.DescendantAdded:Connect(function(d)
			if d:IsA("BaseRemoteEvent") then hookRemote(d)
			elseif d.ClassName == "RemoteFunction" then pcall(hookClientInvoke, d) end
		end)
	end

	local function disconnectIncoming()
		for _, c in ipairs(Remote.incomingCons) do pcall(function() c:Disconnect() end) end
		Remote.incomingCons = {}
		if Remote.descCon then Remote.descCon:Disconnect() Remote.descCon = nil end
		Remote.incomingConnected = false
	end

	local function replayRemote(e)
		local r = e.remote
		if e.dir == "in" then
			local fs = G("firesignal")
			if not fs then error("firesignal is not supported by your executor") end
			fs(r.OnClientEvent, unpack(e.args, 1, e.args.n))
		else
			task.spawn(function()
				local ok, err = pcall(function() return r[e.method](r, unpack(e.args, 1, e.args.n)) end)
				if not ok then warn("[BAD DEX Spies] replay failed: " .. tostring(err)) end
			end)
		end
	end

	local function scriptPath(s)
		if typeof(s) == "Instance" then return pathOf(s) end
		return "nil"
	end

	local function remoteDetail(e, full, style)
		local out = {}
		out[#out + 1] = "-- Remote:  " .. pathOf(e.remote)
		out[#out + 1] = "-- Class:   " .. e.class .. "   Method: " .. e.method .. "   Time: " .. e.clock
		out[#out + 1] = "-- Calling script: " .. scriptPath(e.script)
		if e.blocked then out[#out + 1] = "-- BLOCKED: this call never reached the server" end
		if e.ret then
			local rp = serializeArgs(e.ret)
			out[#out + 1] = "-- Return (" .. e.ret.n .. "): " .. (table.concat(rp, ", "):gsub("\n", "\n--   "))
		elseif e.method:lower() == "invokeserver" and not e.blocked then
			out[#out + 1] = "-- Return: (still pending / errored)"
		end
		out[#out + 1] = ""
		out[#out + 1] = (style == "utopia") and utopiaCode(e) or genRemoteCode(e)
		if full and e.trace and e.trace ~= "" then
			out[#out + 1] = ""
			out[#out + 1] = "--[[ traceback"
			out[#out + 1] = traceBlock(e.trace)
			out[#out + 1] = "]]"
		end
		return table.concat(out, "\n")
	end

	local function remoteRowText(e)
		local arrow = e.dir == "in" and "<- " or "-> "
		return string.format("[%s] %s%s : %s", e.clock, arrow, e.name, e.method)
	end

	local function toggleText(label, on) return label .. ": " .. (on and "ON" or "OFF") end

	local function buildRemotePanel(kind)
		local isCobalt = kind == "cobalt"
		local ignoredSet = isCobalt and Remote.cobaltIgnored or Remote.simpleIgnored
		local flag = isCobalt and "cobalt" or "simple"
		local gen = isCobalt and genRemoteCode or utopiaCode -- UtopiaSpy tab = UtopiaSpy code generator
		local P

		local function sel() return P.selected and P.selected.Data end
		local function needSel()
			local e = sel()
			if not e then P.setDetail("-- select a call first") end
			return e
		end
		local function copyOrShow(text)
			if not copyText(text) then P.setDetail("-- executor has no setclipboard; copy the code from this box\n\n" .. text) end
		end
		-- all recorded calls (still in the list) of the same remote as `e`, oldest first
		local function callsOf(e)
			local list = {}
			for _, row in ipairs(P.rows) do
				if row.Data.remote == e.remote then list[#list + 1] = row.Data end
			end
			return list
		end

		local buttons = {}
		local function add(text, width, fn, init) buttons[#buttons + 1] = {text, width, fn, init} end

		add("Enable: OFF", 84, function(btn)
			if not Remote[flag] then
				local ok, err = installRemote()
				if not ok then P.setDetail("-- cannot enable: " .. tostring(err)) return end
				Remote[flag] = true
				if Remote.incoming then connectIncoming() end
			else
				Remote[flag] = false
				if not (Remote.cobalt or Remote.simple) then disconnectIncoming() end
			end
			btn.Text = toggleText("Enable", Remote[flag])
		end, function(btn) btn.Text = toggleText("Enable", Remote[flag]) end)

		add("Incoming: ON", 86, function(btn)
			Remote.incoming = not Remote.incoming
			if Remote.cobalt or Remote.simple then
				if Remote.incoming then connectIncoming() else disconnectIncoming() end
			end
			btn.Text = toggleText("Incoming", Remote.incoming)
		end, function(btn) btn.Text = toggleText("Incoming", Remote.incoming) end)
		if isCobalt then
			add("Bindables: OFF", 94, function(btn)
				Remote.bindables = not Remote.bindables
				btn.Text = toggleText("Bindables", Remote.bindables)
			end, function(btn) btn.Text = toggleText("Bindables", Remote.bindables) end)
			add("Trace: ON", 70, function(btn)
				Remote.trace = not Remote.trace
				btn.Text = toggleText("Trace", Remote.trace)
			end, function(btn) btn.Text = toggleText("Trace", Remote.trace) end)
		end

		add("Copy Code", 70, function()
			local e = needSel() if not e then return end
			copyOrShow(gen(e))
		end)
		if not isCobalt then
			-- UtopiaSpy per-remote copy buttons
			add("Copy last x10", 94, function()
				local e = needSel() if not e then return end
				local calls, out = callsOf(e), {}
				for i = math.max(1, #calls - 9), #calls do out[#out + 1] = gen(calls[i]) end
				copyOrShow(table.concat(out, "\n\n"))
			end)
			add("Copy all", 70, function()
				local e = needSel() if not e then return end
				local out = {}
				for _, c in ipairs(callsOf(e)) do out[#out + 1] = gen(c) end
				copyOrShow(table.concat(out, "\n\n"))
			end)
			add("Get Return", 82, function()
				local e = needSel() if not e then return end
				if e.ret then
					P.setDetail("-- Return values of this call (" .. e.ret.n .. "):\n" .. utopiaArgsTable(e.ret))
				elseif e.method:lower() == "invokeserver" then
					P.setDetail("-- no return value captured (call blocked, still pending, or it errored)")
				else
					P.setDetail("-- " .. e.method .. " has no return value")
				end
			end)
		end
		add(isCobalt and "Replay" or "Run", 56, function()
			local e = needSel() if not e then return end
			replayRemote(e)
		end)
		add("Copy Path", 70, function()
			local e = needSel() if not e then return end
			copyText(pathOf(e.remote))
		end)
		if isCobalt then
			add("View Script", 76, function()
				local e = needSel() if not e then return end
				if typeof(e.script) == "Instance" and ScriptViewer then
					ScriptViewer.ViewScript(e.script)
				else
					P.setDetail("-- no calling script recorded for this call")
				end
			end)
		end
		add("Ignore", 56, function()
			local e = needSel() if not e then return end
			ignoredSet[e.remote] = true
			P.setDetail("-- ignoring " .. e.name .. " (use Reset to undo)")
		end)
		if not isCobalt then
			-- UtopiaSpy blacklistedNames: hide every remote with this NAME (also remotes created later)
			add("Ignore Name", 90, function()
				local e = needSel() if not e then return end
				if not table.find(Utopia.blacklistedNames, e.name) then table.insert(Utopia.blacklistedNames, e.name) end
				P.setDetail("-- \"" .. e.name .. "\" added to blacklistedNames (use Reset to undo)")
			end)
		end
		add("Block", 52, function(btn)
			local e = needSel() if not e then return end
			Remote.blocked[e.remote] = not Remote.blocked[e.remote] or nil
			P.setDetail("-- " .. e.name .. (Remote.blocked[e.remote] and " is now BLOCKED (calls are dropped client-side)" or " is no longer blocked"))
		end)
		add("Reset", 52, function()
			table.clear(ignoredSet)
			table.clear(Remote.blocked)
			if not isCobalt then table.clear(Utopia.blacklistedNames) end
			P.setDetail("-- cleared ignored / blocked lists")
		end)
		add("Clear", 52, function() P.clear() end)

		P = makePanel({
			name = isCobalt and "Cobalt" or "UtopiaSpy",
			buttons = buttons,
			hint = (isCobalt and "-- Cobalt: outgoing + incoming remote traffic, return values, calling script, traceback.\n"
				or "-- UtopiaSpy: outgoing FireServer / InvokeServer + incoming OnClientEvent / OnClientInvoke,\n-- UtopiaSpy-style code (Remote:FireServer(table.unpack({...})), function dumps, utf8.char names).\n")
				.. "-- Press Enable, then do something in the game. Click a call to see the generated code.\n"
				.. "-- Needs hookmetamethod + getnamecallmethod (hookfunction/getcallingscript/firesignal/getcallbackmember improve it).\n"
				.. (isCobalt and "" or "-- Settings (blacklistedNames, maxTableDepth, newFunctionMethod, ...): search for [SPIES:UTOPIA] in the Spies module."),
		})
		if isCobalt then Spies.CobaltPanel = P else Spies.SimplePanel = P end
		return P
	end

	dispatchRemote = function(e)
		local function show(P, ignored, full, style)
			if ignored[e.remote] then return end
			if style == "utopia" and table.find(Utopia.blacklistedNames, e.name) then return end
			local color = e.blocked and COL_BLOCK or (e.dir == "in" and COL_IN or COL_OUT)
			P.addRow(remoteRowText(e), color, e, function(row) P.setDetail(remoteDetail(row.Data, full, style)) end)
		end
		if Remote.simple and Spies.SimplePanel and (e.dir ~= "in" or Remote.incoming) then show(Spies.SimplePanel, Remote.simpleIgnored, false, "utopia") end
		if Remote.cobalt and Spies.CobaltPanel then show(Spies.CobaltPanel, Remote.cobaltIgnored, true) end
	end

	---------------------------------------------------------------------
	-- Function inspection helpers (Hydroxide / Closure Spy)
	---------------------------------------------------------------------
	local function fnInfo(f)
		local getinfo = (debug and debug.getinfo) or G("getinfo")
		if getinfo then
			local ok, i = pcall(getinfo, f)
			if ok and type(i) == "table" then return i end
		end
		return {}
	end

	local function fnScript(f)
		local ok, e = pcall(getfenv, f)
		if ok and type(e) == "table" then
			local ok2, s = pcall(rawget, e, "script")
			if ok2 and typeof(s) == "Instance" then return s end
		end
		return nil
	end

	local function isCClosure(f)
		local iscc = G("iscclosure")
		if iscc then
			local ok, r = pcall(iscc, f)
			if ok then return r end
		end
		return false
	end

	local function isExecClosure(f)
		local fn = G("isexecutorclosure") or G("checkclosure") or G("is_synapse_function") or G("is_executor_closure")
		if fn then
			local ok, r = pcall(fn, f)
			if ok then return r end
		end
		return false
	end

	local function oneLine(v, cap)
		local ok, s = pcall(serialize, v, 0, {}, 5)
		if not ok then s = tostring(v) end
		s = s:gsub("%s+", " ")
		cap = cap or 120
		if #s > cap then s = s:sub(1, cap) .. "..." end
		return s
	end

	local function describeFn(f)
		if type(f) ~= "function" then return tostring(f) end
		local i = fnInfo(f)
		local scr = fnScript(f)
		return string.format("%s [%s:%s] %s%s",
			(i.name and i.name ~= "") and i.name or "anonymous",
			scr and scr.Name or tostring(i.short_src or i.source or "?"),
			tostring(i.linedefined or i.currentline or "?"),
			isCClosure(f) and "C closure" or "Lua closure",
			isExecClosure(f) and ", executor" or "")
	end

	local function fnDetail(f)
		local out = {}
		local i = fnInfo(f)
		local scr = fnScript(f)
		out[#out + 1] = "-- Function: " .. ((i.name and i.name ~= "") and i.name or "anonymous")
		out[#out + 1] = "-- Type:     " .. (isCClosure(f) and "C closure" or "Lua closure") .. (isExecClosure(f) and " (executor)" or "")
		out[#out + 1] = "-- Script:   " .. (scr and pathOf(scr) or "unknown")
		out[#out + 1] = "-- Source:   " .. tostring(i.source or i.short_src or "?") .. "   line " .. tostring(i.linedefined or "?")
		out[#out + 1] = "-- Params:   " .. tostring(i.numparams or i.nparams or "?") .. "   vararg: " .. tostring(i.is_vararg or i.isvararg or "?")
		local fnames = {
			ups = G("getupvalues") or (debug and debug.getupvalues),
			consts = G("getconstants") or (debug and debug.getconstants),
			protos = G("getprotos") or (debug and debug.getprotos),
		}
		if fnames.ups then
			local ok, ups = pcall(fnames.ups, f)
			if ok and type(ups) == "table" then
				local keys = {}
				for k in pairs(ups) do keys[#keys + 1] = k end
				table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
				out[#out + 1] = ""
				out[#out + 1] = "-- Upvalues (" .. #keys .. "):"
				for n, k in ipairs(keys) do
					if n > 80 then out[#out + 1] = "--   ..." break end
					out[#out + 1] = "--   [" .. tostring(k) .. "] (" .. typeof(ups[k]) .. ") = " .. oneLine(ups[k])
				end
			end
		end
		if fnames.consts then
			local ok, cs = pcall(fnames.consts, f)
			if ok and type(cs) == "table" then
				local keys = {}
				for k in pairs(cs) do keys[#keys + 1] = k end
				table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
				out[#out + 1] = ""
				out[#out + 1] = "-- Constants (" .. #keys .. "):"
				for n, k in ipairs(keys) do
					if n > 120 then out[#out + 1] = "--   ..." break end
					out[#out + 1] = "--   [" .. tostring(k) .. "] " .. oneLine(cs[k], 100)
				end
			end
		end
		if fnames.protos then
			local ok, ps = pcall(fnames.protos, f)
			if ok and type(ps) == "table" then
				out[#out + 1] = ""
				out[#out + 1] = "-- Protos: " .. #ps
				for n, p in ipairs(ps) do
					if n > 40 then break end
					if type(p) == "function" then out[#out + 1] = "--   " .. describeFn(p) end
				end
			end
		end
		return table.concat(out, "\n")
	end

	local function compileExpr(src)
		local ls = G("loadstring") or loadstring
		if not ls then return nil, "loadstring not available" end
		local fn, err = ls("return " .. src)
		if not fn then return nil, err end
		return fn
	end

	---------------------------------------------------------------------
	-- Closure Spy
	---------------------------------------------------------------------
	local Closure = {hooked = {}, list = {}}
	local dispatchClosure

	local function hookClosure(f, label)
		if type(f) ~= "function" then return false, "not a function" end
		if Closure.hooked[f] then return false, "already hooked" end
		local hookf = G("hookfunction")
		if not hookf then return false, "executor lacks hookfunction" end
		local newcc = G("newcclosure") or function(x) return x end
		local checkcaller = G("checkcaller") or function() return false end
		local rec = {fn = f, label = label or fnName(f), active = true, block = false, calls = 0}
		local old
		-- [SPIES:CLOSURE-HOOK] wrapper that replaces every hooked closure; logging + blocking happen here
		local function wrapper(...)
			if rec.active and not checkcaller() then
				rec.calls = rec.calls + 1
				local e = {rec = rec, args = pack(...), clock = nowStr(), trace = debug.traceback("", 2)}
				push(function() dispatchClosure(e) end)
				if rec.block then return end
				local r = pack(old(...))
				e.ret = r
				return unpack(r, 1, r.n)
			end
			return old(...)
		end
		local wrapped = wrapper
		if isCClosure(f) then wrapped = newcc(wrapper) end
		local ok, res = pcall(hookf, f, wrapped)
		if not ok then return false, tostring(res) end
		old = res
		Closure.hooked[f] = rec
		Closure.list[#Closure.list + 1] = rec
		startQueue()
		return true, rec
	end

	local function unhookClosure(rec)
		rec.active = false
		local rf = G("restorefunction")
		if rf then pcall(rf, rec.fn) end
		Closure.hooked[rec.fn] = nil
	end

	local function gcFunctions()
		local getgc = G("getgc")
		if not getgc then return nil, "executor lacks getgc" end
		local ok, list = pcall(getgc, true)
		if not ok or type(list) ~= "table" then
			ok, list = pcall(getgc)
		end
		if not ok then return nil, tostring(list) end
		return list
	end

	local function buildClosurePanel()
		local P
		local function needRec()
			local row = P.selected
			if not row or not row.Data then P.setDetail("-- select a logged call first") return nil end
			return row.Data.rec, row.Data
		end
		local buttons = {
			{"Hook by name", 90, function()
				local name = P.boxes.name.Text
				if name == "" then P.setDetail("-- type a function name into the box first") return end
				local list, err = gcFunctions()
				if not list then P.setDetail("-- " .. tostring(err)) return end
				local n = 0
				for _, f in ipairs(list) do
					if type(f) == "function" and not isCClosure(f) and not isExecClosure(f) then
						local nm = fnInfo(f).name
						if nm == name then
							local ok = hookClosure(f, name)
							if ok then n = n + 1 end
							if n >= 25 then break end
						end
					end
				end
				P.setDetail("-- hooked " .. n .. " closure(s) named '" .. name .. "'. Trigger them in-game and calls will show here.")
			end},
			{"Hooked list", 76, function()
				local out = {"-- Hooked closures:"}
				for i, rec in ipairs(Closure.list) do
					out[#out + 1] = string.format("-- %d. %s  calls=%d  %s%s", i, rec.label, rec.calls, rec.active and "active" or "unhooked", rec.block and "  BLOCKING" or "")
				end
				P.setDetail(table.concat(out, "\n"))
			end},
			{"Block", 52, function()
				local rec = needRec() if not rec then return end
				rec.block = not rec.block
				P.setDetail("-- " .. rec.label .. (rec.block and " now BLOCKED (original is not called)" or " no longer blocked"))
			end},
			{"Unhook", 60, function()
				local rec = needRec() if not rec then return end
				unhookClosure(rec)
				P.setDetail("-- unhooked " .. rec.label)
			end},
			{"Unhook All", 74, function()
				for _, rec in ipairs(Closure.list) do unhookClosure(rec) end
				P.setDetail("-- all closures unhooked")
			end},
			{"Copy Args", 70, function()
				local _, e = needRec() if not e then return end
				local parts = serializeArgs(e.args)
				copyText("-- " .. e.rec.label .. " args\nreturn " .. table.concat(parts, ", "))
			end},
			{"Clear", 52, function() P.clear() end},
		}
		P = makePanel({
			name = "ClosureSpy",
			buttons = buttons,
			boxes = {{"function name to hook", 150, "name"}},
			hint = "-- Closure Spy: logs calls (args, returns, traceback) of hooked Lua closures.\n"
				.. "-- Hook a function by name (getgc scan), or use Hydroxide -> pick a function -> 'Spy Closure'.\n"
				.. "-- Needs hookfunction (+ getgc for name search).",
		})
		Spies.ClosurePanel = P
		return P
	end

	dispatchClosure = function(e)
		local P = Spies.ClosurePanel
		if not P then return end
		local previews = {}
		for i = 1, math.min(e.args.n, 4) do previews[i] = oneLine(e.args[i], 24) end
		local text = string.format("[%s] %s(%s%s)", e.clock, e.rec.label, table.concat(previews, ", "), e.args.n > 4 and ", ..." or "")
		P.addRow(text, e.rec.block and COL_BLOCK or COL_OUT, e, function(row)
			local d = row.Data
			local out = {}
			out[#out + 1] = "-- Closure: " .. d.rec.label .. "   total calls: " .. d.rec.calls .. (d.rec.block and "   [BLOCKING]" or "")
			out[#out + 1] = "-- Time: " .. d.clock
			out[#out + 1] = ""
			out[#out + 1] = "-- Arguments (" .. d.args.n .. "):"
			local ps = serializeArgs(d.args)
			for i = 1, d.args.n do out[#out + 1] = "local arg" .. i .. " = " .. ps[i] end
			if d.ret then
				out[#out + 1] = ""
				out[#out + 1] = "-- Returned (" .. d.ret.n .. "):"
				local rs = serializeArgs(d.ret)
				for i = 1, d.ret.n do out[#out + 1] = "local ret" .. i .. " = " .. rs[i] end
			elseif d.rec.block then
				out[#out + 1] = ""
				out[#out + 1] = "-- (call was blocked, nothing returned)"
			end
			if d.trace then
				out[#out + 1] = ""
				out[#out + 1] = "--[[ traceback"
				out[#out + 1] = traceBlock(d.trace)
				out[#out + 1] = "]]"
			end
			P.setDetail(table.concat(out, "\n"))
		end)
	end

	---------------------------------------------------------------------
	-- Hydroxide (scanner: functions / scripts / modules / remotes)
	---------------------------------------------------------------------
	local Hydro = {mode = 1, scanning = false}
	local HYDRO_MODES = {"Functions", "Scripts", "Modules", "Remotes"}

	local function matchesFilter(fl, ...)
		if fl == "" then return true end
		for i = 1, select("#", ...) do
			local s = select(i, ...)
			if type(s) == "string" and s:lower():find(fl, 1, true) then return true end
		end
		return false
	end

	local function fnMatches(f, fl, info, scr)
		if fl == "" then return true end
		if matchesFilter(fl, info.name or "", tostring(info.short_src or info.source or ""), scr and pathOf(scr) or "") then return true end
		local gcn, gup = G("getconstants") or (debug and debug.getconstants), G("getupvalues") or (debug and debug.getupvalues)
		if gcn then
			local ok, cs = pcall(gcn, f)
			if ok and type(cs) == "table" then
				for _, c in pairs(cs) do
					if type(c) == "string" and c:lower():find(fl, 1, true) then return true end
				end
			end
		end
		if gup then
			local ok, us = pcall(gup, f)
			if ok and type(us) == "table" then
				for _, u in pairs(us) do
					if type(u) == "string" and u:lower():find(fl, 1, true) then return true end
				end
			end
		end
		return false
	end

	local function scriptDetail(inst)
		local out = {}
		out[#out + 1] = "-- Script:  " .. pathOf(inst)
		out[#out + 1] = "-- Class:   " .. inst.ClassName
		pcall(function()
			if inst:IsA("BaseScript") then
				out[#out + 1] = "-- Enabled: " .. tostring(inst.Enabled) .. "   RunContext: " .. tostring(inst.RunContext)
			end
		end)
		local gse = G("getsenv")
		if gse and inst.ClassName ~= "Script" then
			local ok, senv = pcall(gse, inst)
			if ok and type(senv) == "table" then
				local keys = {}
				for k in pairs(senv) do keys[#keys + 1] = k end
				table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
				out[#out + 1] = ""
				out[#out + 1] = "-- Script environment (getsenv) - " .. #keys .. " entries:"
				for n, k in ipairs(keys) do
					if n > 150 then out[#out + 1] = "--   ..." break end
					local v = senv[k]
					if type(v) == "function" then
						out[#out + 1] = "--   " .. tostring(k) .. " = " .. describeFn(v)
					else
						out[#out + 1] = "--   " .. tostring(k) .. " (" .. typeof(v) .. ") = " .. oneLine(v)
					end
				end
			else
				out[#out + 1] = ""
				out[#out + 1] = "-- getsenv failed (script not running / not supported)"
			end
		end
		return table.concat(out, "\n")
	end

	local function remoteHandlers(r)
		local list = {}
		local gcon = G("getconnections")
		if gcon and (r:IsA("BaseRemoteEvent")) then
			local ok, cons = pcall(gcon, r.OnClientEvent)
			if ok and type(cons) == "table" then
				for _, c in ipairs(cons) do
					local okf, f = pcall(function() return c.Function end)
					list[#list + 1] = {con = c, fn = okf and type(f) == "function" and f or nil}
				end
			end
		elseif r:IsA("RemoteFunction") then
			local gcb = G("getcallbackvalue")
			if gcb then
				local ok, f = pcall(gcb, r, "OnClientInvoke")
				if ok and type(f) == "function" then list[#list + 1] = {fn = f} end
			end
		end
		return list
	end

	local function remoteDetailHydro(r)
		local out = {}
		out[#out + 1] = "-- Remote: " .. pathOf(r)
		out[#out + 1] = "-- Class:  " .. r.ClassName
		local hs = remoteHandlers(r)
		out[#out + 1] = ""
		out[#out + 1] = "-- Client handlers (" .. #hs .. "):"
		for i, h in ipairs(hs) do
			local enabled = ""
			if h.con then
				local ok, en = pcall(function() return h.con.Enabled end)
				if ok then enabled = "  enabled=" .. tostring(en) end
			end
			out[#out + 1] = "--   " .. i .. ". " .. (h.fn and describeFn(h.fn) or "(no Lua function / C connection)") .. enabled
		end
		out[#out + 1] = ""
		out[#out + 1] = "local remote = " .. pathOf(r)
		if r:IsA("RemoteFunction") then
			out[#out + 1] = "-- remote:InvokeServer(...)"
		elseif r:IsA("BaseRemoteEvent") then
			out[#out + 1] = "-- remote:FireServer(...)"
		end
		return table.concat(out, "\n")
	end

	local function moduleDetail(m)
		local out = {}
		out[#out + 1] = "-- ModuleScript: " .. pathOf(m)
		local ok, res = pcall(require, m)
		out[#out + 1] = ""
		if not ok then
			out[#out + 1] = "-- require failed: " .. tostring(res)
		else
			out[#out + 1] = "-- require() returned (" .. typeof(res) .. "):"
			local okS, s = pcall(serialize, res, 0, {}, 0)
			out[#out + 1] = "local module = " .. (okS and s or tostring(res))
		end
		return table.concat(out, "\n")
	end

	-- [SPIES:HYDROXIDE] scanner tab: scan() has one branch per mode (Functions/Scripts/Modules/Remotes)
	local function buildHydroPanel()
		local P

		local function scan()
			if Hydro.scanning then P.setDetail("-- scan already running") return end
			Hydro.scanning = true
			P.clear()
			local mode = Hydro.mode
			local fl = P.boxes.filter.Text:lower()
			task.spawn(function()
				local ok, err = pcall(function()
					local count = 0
					local CAP = 400
					if mode == 1 then
						local list, e = gcFunctions()
						if not list then error(e, 0) end
						for idx, f in ipairs(list) do
							if idx % 1500 == 0 then task.wait() end
							if type(f) == "function" and not isCClosure(f) and not isExecClosure(f) then
								local info = fnInfo(f)
								local scr = fnScript(f)
								if (fl ~= "" or (info.name and info.name ~= "")) and fnMatches(f, fl, info, scr) then
									local nm = (info.name and info.name ~= "") and info.name or "anonymous"
									P.addRow(string.format("%s  [%s:%s]", nm, scr and scr.Name or tostring(info.short_src or "?"), tostring(info.linedefined or "?")),
										nil, {kind = "fn", fn = f}, function(row) P.setDetail(fnDetail(row.Data.fn)) end)
									count = count + 1
									if count >= CAP then break end
								end
							end
						end
					elseif mode == 2 then
						local gs = G("getscripts")
						local list
						if gs then
							local ok2, r = pcall(gs)
							if ok2 then list = r end
						end
						if not list then
							list = {}
							for _, d in ipairs(game:GetDescendants()) do
								if d:IsA("LuaSourceContainer") then list[#list + 1] = d end
							end
						end
						for idx, s in ipairs(list) do
							if idx % 800 == 0 then task.wait() end
							if typeof(s) == "Instance" and matchesFilter(fl, s.Name, pathOf(s), s.ClassName) then
								P.addRow("[" .. s.ClassName .. "] " .. s.Name, nil, {kind = "script", inst = s},
									function(row) P.setDetail(scriptDetail(row.Data.inst)) end)
								count = count + 1
								if count >= CAP then break end
							end
						end
					elseif mode == 3 then
						local glm = G("getloadedmodules")
						local list
						if glm then
							local ok2, r = pcall(glm)
							if ok2 then list = r end
						end
						if not list then
							list = {}
							for _, d in ipairs(game:GetDescendants()) do
								if d:IsA("ModuleScript") then list[#list + 1] = d end
							end
						end
						for idx, m in ipairs(list) do
							if idx % 800 == 0 then task.wait() end
							if typeof(m) == "Instance" and matchesFilter(fl, m.Name, pathOf(m)) then
								P.addRow(m.Name, nil, {kind = "module", inst = m}, function(row) P.setDetail(moduleDetail(row.Data.inst)) end)
								count = count + 1
								if count >= CAP then break end
							end
						end
					else
						local list = {}
						for _, d in ipairs(game:GetDescendants()) do
							if d:IsA("BaseRemoteEvent") or d:IsA("RemoteFunction") then list[#list + 1] = d end
						end
						local gni = G("getnilinstances")
						if gni then
							local ok2, nils = pcall(gni)
							if ok2 and type(nils) == "table" then
								for _, d in ipairs(nils) do
									if typeof(d) == "Instance" and (d:IsA("BaseRemoteEvent") or d:IsA("RemoteFunction")) then list[#list + 1] = d end
								end
