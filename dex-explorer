	dispatchMeta = function(e)
		local P = Spies.MetaPanel
		if not P then return end
		local tname
		if typeof(e.target) == "Instance" then
			local ok, n = pcall(function() return e.target.Name end)
			tname = ok and n or "?"
		else
			tname = e.label or tostring(e.target)
		end
		local text
		if e.kind == "index" then
			text = string.format("[%s] %s.%s", e.clock, tname, tostring(e.key))
		elseif e.kind == "newindex" then
			text = string.format("[%s] %s.%s = %s", e.clock, tname, tostring(e.key), oneLine(e.value and e.value[1], 30))
		elseif e.kind == "namecall" then
			text = string.format("[%s] %s:%s(...)", e.clock, tname, tostring(e.key))
		else
			text = string.format("[%s] %s %s", e.clock, tname, tostring(e.key))
		end
		local color = e.kind == "index" and COL_OUT or (e.kind == "newindex" and COL_WARN or COL_IN)
		P.addRow(text, color, e, function(row)
			local d = row.Data
			local out = {}
			out[#out + 1] = "-- " .. d.kind:upper() .. " at " .. d.clock
			out[#out + 1] = "-- Target: " .. (typeof(d.target) == "Instance" and pathOf(d.target) or tostring(d.target))
			out[#out + 1] = "-- Key:    " .. oneLine(d.key)
			if d.value then out[#out + 1] = "-- Value:  " .. oneLine(d.value[1], 400) end
			if d.args then
				out[#out + 1] = ""
				out[#out + 1] = "-- Arguments (" .. d.args.n .. "):"
				local ps = serializeArgs(d.args)
				for i = 1, d.args.n do out[#out + 1] = "local arg" .. i .. " = " .. ps[i] end
				if d.kind == "namecall" and typeof(d.target) == "Instance" then
					out[#out + 1] = ""
					out[#out + 1] = pathOf(d.target) .. ":" .. tostring(d.key) .. "(" .. (d.args.n > 0 and "..." or "") .. ")"
				end
			end
			out[#out + 1] = ""
			out[#out + 1] = "--[[ traceback"
			out[#out + 1] = traceBlock(d.trace)
			out[#out + 1] = "]]"
			P.setDetail(table.concat(out, "\n"))
		end)
	end

	---------------------------------------------------------------------
	-- Originals (load the real tools from their official repos)
	---------------------------------------------------------------------
	local HYDRO_BASE = "https://raw.githubusercontent.com/Upbolt/Hydroxide/revision/%s.lua"
	-- [SPIES:ORIGINALS] add more official scripts here: {id = "Name", url = "raw url", note = "...", overrides = {...}}
	-- Each entry automatically gets a "Load <id>" button in the Originals tab.
	local ORIGINALS = {
		-- UtopiaSpy: the full original script is embedded in this file (UTOPIA_SRC, search [SPIES:UTOPIA-SRC]),
		-- so it needs no download and runs exactly as supplied.
		{id = "UtopiaSpy", source = UTOPIA_SRC,
			note = "UtopiaSpy (Made by UtopiaTM) - embedded copy, runs as-is; its own window opens separately (RightAlt = minimise)"},
		{id = "Cobalt", url = "https://github.com/notpoiu/cobalt/releases/latest/download/Cobalt.luau",
			note = "Cobalt by notpoiu - latest release (loader URL taken from the official Cobalt docs). If it says 'HTML page', your executor's HttpGet is not following GitHub's release redirect: download Cobalt.luau yourself, host it somewhere raw, paste that URL into the box and press 'Load URL'."},
	}

	-- a "script" that starts with "<" is an HTML error/redirect page, not Lua
	local function looksLikeHtml(body)
		return type(body) == "string" and body:match("^%s*<") ~= nil
	end

	-- [SPIES:HTTP] tries game:HttpGet, game:HttpGetAsync, then the executor's request() (follows redirects better)
	local function httpGet(url)
		local lastErr = "no http function available"
		local ok, body = pcall(function() return game:HttpGet(url) end)
		if ok and type(body) == "string" and #body > 0 and not looksLikeHtml(body) then return true, body end
		if ok and looksLikeHtml(body) then lastErr = "HttpGet returned an HTML page: " .. body:sub(1, 80):gsub("%s+", " ") end
		ok, body = pcall(function() return game:HttpGetAsync(url) end)
		if ok and type(body) == "string" and #body > 0 and not looksLikeHtml(body) then return true, body end
		local req = G("request") or G("http_request") or (G("syn") and G("syn").request)
		if req then
			local ok2, res = pcall(req, {Url = url, Method = "GET"})
			if ok2 and type(res) == "table" and type(res.Body) == "string" and #res.Body > 0 then
				if not looksLikeHtml(res.Body) then return true, res.Body end
				lastErr = "request() returned HTML (HTTP " .. tostring(res.StatusCode) .. "): " .. res.Body:sub(1, 80):gsub("%s+", " ")
			elseif ok2 then
				lastErr = "request() failed: HTTP " .. tostring(res and res.StatusCode)
			else
				lastErr = tostring(res)
			end
		end
		return false, lastErr
	end

	-- overrides = optional table of globals the loaded script sees instead of the real ones
	-- (everything else falls through to getgenv()); used below to adapt old scripts to new executors
	local function runChunk(body, chunk, overrides)
		local ls = G("loadstring") or loadstring
		if not ls then return false, "executor lacks loadstring" end
		local fn, err = ls(body, "=" .. chunk)
		if not fn then return false, "compile error: " .. tostring(err) end
		if overrides then
			local base = (getgenv and getgenv()) or getfenv(fn)
			local proxy = setmetatable({}, {
				__index = function(_, k)
					local v = overrides[k]
					if v ~= nil then return v end
					return base[k]
				end,
				__newindex = function(_, k, v) base[k] = v end,
			})
			pcall(setfenv, fn, proxy)
		end
		local ok2, res = pcall(fn)
		if not ok2 then return false, "runtime error: " .. tostring(res) end
		return true, #body
	end

	local function loadRemote(url, chunk, overrides)
		local ok, body = httpGet(url)
		if not ok then return false, "download failed: " .. tostring(body) end
		return runChunk(body, chunk, overrides)
	end

	local function buildOriginalsPanel()
		local P
		local function run(name, fn)
			P.setDetail("-- loading " .. name .. " ...")
			task.spawn(function()
				local ok, a = pcall(fn)
				if not ok then P.setDetail("-- " .. name .. " failed: " .. tostring(a)) return end
				if a == true or a == nil then
					P.setDetail("-- " .. name .. " loaded.")
				else
					P.setDetail("-- " .. name .. " finished: " .. tostring(a))
				end
			end)
		end
		local buttons = {}
		for _, o in ipairs(ORIGINALS) do
			buttons[#buttons + 1] = {"Load " .. o.id, 100, function()
				run(o.id, function()
					local ov = o.overrides
					if type(ov) == "function" then ov = ov() end
					local ok, info
					if o.source then ok, info = runChunk(o.source, o.id, ov) else ok, info = loadRemote(o.url, o.id, ov) end
					if not ok then error(info, 0) end
					return o.id .. " loaded (" .. info .. " bytes)\n-- " .. o.note
				end)
			end}
		end
		buttons[#buttons + 1] = {"Load Hydroxide", 110, function()
			run("Hydroxide", function()
				local ok, err = loadRemote(HYDRO_BASE:format("init"), "init.lua")
				if not ok then error("init: " .. tostring(err), 0) end
				local ok2, err2 = loadRemote(HYDRO_BASE:format("ui/main"), "ui/main.lua")
				if not ok2 then error("ui/main: " .. tostring(err2), 0) end
				return "Hydroxide loaded (Remote Spy, Closure Spy, scanners are inside its own UI)"
			end)
		end}
		buttons[#buttons + 1] = {"Load URL", 70, function()
			local url = P.boxes.url.Text
			if url == "" then P.setDetail("-- paste a raw script URL into the box first") return end
			run(url, function()
				local ok, info = loadRemote(url, "custom")
				if not ok then error(info, 0) end
				return "loaded " .. info .. " bytes"
			end)
		end}
		buttons[#buttons + 1] = {"Skidnet jelly windows: ON", 140, function(btn)
			Lib.Skin.Enabled = not Lib.Skin.Enabled
			btn.Text = "Skidnet jelly windows: " .. (Lib.Skin.Enabled and "ON" or "OFF")
		end, function(btn) btn.Text = "Skidnet jelly windows: " .. (Lib.Skin.Enabled and "ON" or "OFF") end}
		P = makePanel({
			name = "Originals",
			buttons = buttons,
			boxes = {{"raw script URL (for Load URL)", 260, "url"}},
			hint = "-- Originals: runs the real, unmodified tools straight from their official repositories\n"
				.. "-- (downloaded ones are always the newest version; UtopiaSpy is embedded in this file).\n"
				.. "--\n"
				.. "--   UtopiaSpy   embedded original script (no download needed)\n"
				.. "--   Hydroxide   Upbolt/Hydroxide (revision) - its own Remote Spy, Closure Spy,\n"
				.. "--               Upvalue / Constant / Script / Module scanners\n"
				.. "--   Cobalt      notpoiu/cobalt - latest release (loader URL from the official docs)\n"
				.. "--   Load URL    any other raw script you paste into the box\n"
				.. "--\n"
				.. "-- Needs an executor with loadstring (+ HttpGet or request for the downloaded ones).\n"
				.. "-- The tabs in this window (UtopiaSpy, Cobalt, Hydroxide, ...) are BAD DEX's own\n"
				.. "-- lightweight versions that live inside Dex.",
		})
		Spies.OriginalsPanel = P
		return P
	end

