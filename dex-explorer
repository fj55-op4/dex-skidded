-- client-responsiveness: cooperatively yield so the render thread never hard-freezes.
-- YIELD_TO_CLIENT=false disables it (e.g. server scripts, where there is no render thread).
local YIELD_TO_CLIENT = true
local YIELD_INTERVAL = 1 / 40            -- max seconds of blocking work between yields
local __lastYield = os.clock()
local __runThread = nil                  -- top-level execution thread; only it may yield
local function MaybeYield()
	if not YIELD_TO_CLIENT then return end
	if __runThread == nil or coroutine.running() ~= __runThread then return end
	if os.clock() - __lastYield >= YIELD_INTERVAL then
		pcall(task.wait)                     -- pcall: harmless no-op if this thread cannot yield
		__lastYield = os.clock()
	end
end
