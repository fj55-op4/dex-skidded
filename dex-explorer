                    end
                end

                local WillRun, HasElse = Condition, elseId == 1
                local IsFunc = Typeof(Condition) == "function"

                local Hook = StatementHooks[IfId]
                if Hook ~= nil then
                    WillRun = Hook;
                end

                if IsFunc and (Wrapped[Condition]) then return WillRun end

                if not WillRun then
