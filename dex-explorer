            local StartedAt = Oldest[2]
            
            local Comment = Ast.PermaComment(Ast.RawText(`{Oldest[3] and "didnt run (else)" or "ran"}, if id: {Oldest[#Oldest]}`))
            local Body = Ast.Block{Comment}

            for i = StartedAt + 1, LengthNow do
