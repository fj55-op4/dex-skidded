	-- Lib.Skin  -  Skidnet window engine inside Dex
	--
	-- Port of the Skidnet script: every floating Dex window gets
	--   * a background rasterised into a 2x EditableImage (anti-aliased rounded rect + glass rim)
	--     drawn on an EditableMesh sheet inside a ViewportFrame behind the window,
	--   * KWin "wobbly windows" physics (spring grid, grab constraint, edge collisions),
	--   * a Liquid Glass MeshPart in front of the camera that follows the same deformation,
	--   * macOS traffic-light buttons (close / minimise / centre) and a Roboto title,
	-- and RightCtrl collapses everything into the Skidnet watermark pill (nick / FPS / ping).
	--
	-- The window CONTENT (Explorer tree, Properties, editor, ...) is made of live Instances, so it
	-- cannot be baked into the texture like Skidnet's own rows: it rides rigidly on the centre of the
	-- jelly while the glass behind it deforms. Without EditableMesh/EditableImage support (or when
	-- Skin.Enabled = false) windows keep the same look as plain rounded glass frames (no wobble).
	--
	-- Search for [SKIN:...] markers to find the tunable parts.
	---------------------------------------------------------------------------------------------------
	Lib.Skin = (function()
		local Skin = {Enabled = true, Hidden = false, Supported = nil, UseGlass = true}
		local floor, ceil, clamp, sqrt, abs, max, min, exp, sin =
			math.floor, math.ceil, math.clamp, math.sqrt, math.abs, math.max, math.min, math.exp, math.sin
		local UIS = game:GetService("UserInputService")
		local RunService = game:GetService("RunService")
		local GuiService = game:GetService("GuiService")
		local AssetService = game:GetService("AssetService")
		local TweenService = game:GetService("TweenService")
		local Players = game:GetService("Players")
		local fromOffset = UDim2.fromOffset

		-- [SKIN:CONFIG] physics + look (values taken from Skidnet's WobblyWindows4 preset)
		local CFG = {
			stiffness = 240, damping = 1.8, grab = 2000, grid = {10, 8},
			collide = true, restitution = 0, jellyClick = true,
			radius = 16, bgAlpha = 0.22, rim = 0.80,
			glassTransp = 0.55, refract = 0.70, reflect = 0.15, tint = {255, 255, 255},
		}
		Skin.CFG = CFG
		-- [SKIN:COLORS] Liquid Glass (dark)
		local ST = {
			bg = {10, 12, 16}, text = {255, 255, 255}, dim = {222, 228, 236},
			accent = {61, 174, 233}, close = {255, 95, 87}, min = {254, 188, 46}, center = {40, 200, 64},
		}
		Skin.ST = ST
		local SS = 2                 -- texture supersampling
		local MG = 4                 -- transparent margin around the window (anti-aliased edge)
		local RX, RY = 36, 24        -- window mesh resolution
		local GRX, GRY = 28, 20      -- glass mesh resolution
		local MAX_H = 1 / 360
		local DG = 1
		local PX, PY = CFG.grid[1], CFG.grid[2]
		local NN = PX * PY
		local BAR_H = 20             -- Dex title bar height
		local FONT_MED
		pcall(function() FONT_MED = Font.new("rbxasset://fonts/families/Roboto.json", Enum.FontWeight.Medium) end)

		local hasBuffer = type(buffer) == "table" and buffer.create ~= nil
		local rd8, wr8, wr32, bcopy
		if hasBuffer then rd8, wr8, wr32, bcopy = buffer.readu8, buffer.writeu8, buffer.writeu32, buffer.copy end

		local rigs = {}          -- window -> rig
		local rigList = {}
		local useAlpha = false
		local cam
		local V = {x = 0, y = 0, insetY = 0, fov = 0, tanH = 1}
		local lastTouch
		local conns = {}

		---------------------------------------------------------------- capability check
		local function trySA()
			local sa = Instance.new("SurfaceAppearance")
			local ok = pcall(function() sa.AlphaMode = Enum.AlphaMode.Transparency end)
			if not ok and typeof(sethiddenproperty) == "function" then
				ok = pcall(sethiddenproperty, sa, "AlphaMode", Enum.AlphaMode.Transparency)
			end
			if ok and sa.AlphaMode == Enum.AlphaMode.Transparency then return sa end
			sa:Destroy()
			return nil
		end

		local function checkSupport()
			if Skin.Supported ~= nil then return Skin.Supported end
			Skin.Supported = false
			if not hasBuffer then return false end
			local ok = pcall(function()
				local img = AssetService:CreateEditableImage({Size = Vector2.new(4, 4)})
				img:Destroy()
				local em = AssetService:CreateEditableMesh()
				em:Destroy()
				assert(Content and Content.fromObject)
			end)
			if not ok then return false end
			local t = trySA()
			if t then useAlpha = true t:Destroy() end
			if not useAlpha then CFG.radius = 0 end -- no per-pixel alpha: square corners, like Skidnet
			Skin.Supported = true
			return true
		end

		---------------------------------------------------------------- helpers
		local function smooth(e0, e1, x)
			local t = clamp((x - e0) / (e1 - e0), 0, 1)
			return t * t * (3 - 2 * t)
		end
		local function sdRound(px, py, x, y, w, h, r)
			local qx = abs(px - (x + w * 0.5)) - (w * 0.5 - r)
			local qy = abs(py - (y + h * 0.5)) - (h * 0.5 - r)
			local ox, oy = max(qx, 0), max(qy, 0)
			return sqrt(ox * ox + oy * oy) + min(max(qx, qy), 0) - r
		end
		local function C3(c) return Color3.fromRGB(c[1], c[2], c[3]) end

		---------------------------------------------------------------- rasteriser
		local function fillSpan32(R, o, n, val)
			if n <= 0 then return end
			wr32(R.canvas, o, val)
			local done = 1
			while done < n do
				local c = min(done, n - done)
				bcopy(R.canvas, o + done * 4, R.canvas, o, c * 4)
				done = done + c
			end
		end

		-- [SKIN:BACKGROUND] the window texture: translucent dark body + white glass rim, transparent outside
		local function drawBackground(R)
			local TXW, TXH, WW, WH = R.TXW, R.TXH, R.WW, R.WH
			local canvas = R.canvas
			local rad = CFG.radius * SS
			local rim = useAlpha and CFG.rim or 0
			local bga = useAlpha and CFG.bgAlpha or 1
			local bg = ST.bg
			local x0, y0, w, h = MG * SS, MG * SS, WW * SS, WH * SS
			local band = floor((max(CFG.radius, 16) + MG) * SS + 2)
			if band * 2 > TXW then band = floor(TXW / 2) end
			for py = 0, TXH - 1 do
				if py % 24 == 23 then task.wait() end -- the texture is big: do not freeze the game while painting it
				local fy = py + 0.5
				local yn = clamp((py - y0) / h, 0, 1)
				local sheen = (1 - yn) ^ 3 * 0.10 * rim
				local r, g, b, a = bg[1], bg[2], bg[3], bga
				if sheen > 0 then
					local na = a + sheen * (1 - a)
					r = (r * a * (1 - sheen) + 255 * sheen) / na
					g = (g * a * (1 - sheen) + 255 * sheen) / na
					b = (b * a * (1 - sheen) + 255 * sheen) / na
					a = na
				end
				local inner = floor(r + 0.5) + floor(g + 0.5) * 256 + floor(b + 0.5) * 65536 + floor(a * 255 + 0.5) * 16777216
				local rowO = py * TXW * 4
				local edgeRow = py < band or py >= TXH - band
				local function edgePx(pxx)
					local o = rowO + pxx * 4
					local d = sdRound(pxx + 0.5, fy, x0, y0, w, h, rad)
					local cov = 0.5 - d
					if cov <= 0 then wr32(canvas, o, 0) return end
					if cov > 1 then cov = 1 end
					local R_, G_, B_, A_ = r, g, b, a
					local e = -d / SS
					local nx, ny = (pxx - x0) / w * 2 - 1, yn * 2 - 1
					local dir = 0.3 + 0.7 * abs((-nx - ny) * 0.5)
					local line = clamp(1 - e / 1.6, 0, 1)
					local glow = 1 - clamp(e / 14, 0, 1)
					local wa = clamp(rim * (line * 0.95 * dir + glow * glow * 0.20 * dir), 0, 1)
					if wa > 0 then
						local na = A_ + wa * (1 - A_)
						R_ = (R_ * A_ * (1 - wa) + 255 * wa) / na
						G_ = (G_ * A_ * (1 - wa) + 255 * wa) / na
						B_ = (B_ * A_ * (1 - wa) + 255 * wa) / na
						A_ = na
					end
					wr32(canvas, o, floor(R_ + 0.5) + floor(G_ + 0.5) * 256 + floor(B_ + 0.5) * 65536 + floor(A_ * cov * 255 + 0.5) * 16777216)
				end
				if edgeRow then
					for pxx = 0, TXW - 1 do edgePx(pxx) end
				else
					for pxx = 0, band - 1 do edgePx(pxx) end
					fillSpan32(R, rowO + band * 4, TXW - 2 * band, inner)
					for pxx = TXW - band, TXW - 1 do edgePx(pxx) end
				end
			end
		end

		---------------------------------------------------------------- meshes
		local function anchors(em)
			local L, uv0 = 8, em:AddUV(Vector2.new(0, 0))
			local function tri(p1, p2, p3)
				local f = em:AddTriangle(em:AddVertex(p1), em:AddVertex(p2), em:AddVertex(p3))
				em:SetFaceUVs(f, {uv0, uv0, uv0})
			end
			tri(Vector3.new(-L, -L, L), Vector3.new(L, -L, L), Vector3.new(L, L, L))
			tri(Vector3.new(0, 0, -L), Vector3.new(1e-4, 0, -L), Vector3.new(0, 1e-4, -L))
		end

		-- topology only; rest coordinates (us / vs) are filled by layoutSheet for the current window size
		local function newSheet(nx, ny, glass)
			local em = AssetService:CreateEditableMesh()
			local n1 = nx + 1
			local vids, uvs, nF, nB, ss, tt = {}, {}, {}, {}, {}, {}
			for j = 0, ny do
				for i = 0, nx do
					local k = j * n1 + i + 1
					local s, t = i / nx, j / ny
					if glass then
						s = s - 0.8 * sin(2 * math.pi * s) / (2 * math.pi)
						t = t - 0.8 * sin(2 * math.pi * t) / (2 * math.pi)
					end
					ss[k], tt[k] = s, t
					vids[k] = em:AddVertex(Vector3.new(0, 0, -1))
					uvs[k] = em:AddUV(Vector2.new(i / nx, j / ny))
					if glass then
						nF[k] = em:AddNormal(Vector3.new(0, 0, 1))
						nB[k] = em:AddNormal(Vector3.new(0, 0, -1))
					end
				end
			end
			local function tri(a, b, c, nt)
				local f = em:AddTriangle(vids[a], vids[b], vids[c])
				em:SetFaceUVs(f, {uvs[a], uvs[b], uvs[c]})
				if nt then em:SetFaceNormals(f, {nt[a], nt[b], nt[c]}) end
			end
			for j = 0, ny - 1 do
				for i = 0, nx - 1 do
					local a = j * n1 + i + 1
					local b, c = a + 1, a + n1
					local d = c + 1
					tri(a, c, b, glass and nF); tri(b, c, d, glass and nF)
					tri(a, b, c, glass and nB); tri(b, d, c, glass and nB)
				end
			end
			anchors(em)
			return {em = em, vids = vids, nF = nF, nB = nB, ss = ss, tt = tt, us = {}, vs = {}, n = n1 * (ny + 1), glass = glass}
		end

		local function layoutSheet(sheet, WW, WH)
			for k = 1, sheet.n do
				if sheet.glass then
					sheet.us[k], sheet.vs[k] = sheet.ss[k] * WW, sheet.tt[k] * WH
				else
					sheet.us[k], sheet.vs[k] = -MG + sheet.ss[k] * (WW + 2 * MG), -MG + sheet.tt[k] * (WH + 2 * MG)
				end
			end
		end

		local function sheetPart(sheet)
			local mp = AssetService:CreateMeshPartAsync(Content.fromObject(sheet.em), {CollisionFidelity = Enum.CollisionFidelity.Box})
			mp.Anchored = true
			mp.CanCollide = false
			pcall(function() mp.CanQuery = false; mp.CanTouch = false end)
			mp.CastShadow = false
			pcall(function() mp.Size = mp.MeshSize end)
			mp.CFrame = CFrame.new()
			return mp
		end

		---------------------------------------------------------------- spring grid physics (KWin style)
		-- Catmull-Rom weights from the PX x PY node grid to any mesh vertex
		local function cr1D(f, np)
			local i = clamp(floor(f), 0, np - 2)
			local t = f - i
			local t2, t3 = t * t, t * t * t
			local w = {(-t3 + 2 * t2 - t) / 2, (3 * t3 - 5 * t2 + 2) / 2, (-3 * t3 + 4 * t2 + t) / 2, (t3 - t2) / 2}
			local acc = {}
			for q = 0, 3 do
				local id, ww = i - 1 + q, w[q + 1]
				if id < 0 then acc[0] = (acc[0] or 0) + 2 * ww; acc[1] = (acc[1] or 0) - ww
				elseif id > np - 1 then acc[np - 1] = (acc[np - 1] or 0) + 2 * ww; acc[np - 2] = (acc[np - 2] or 0) - ww
				else acc[id] = (acc[id] or 0) + ww end
			end
			local out = {}
			for id, ww in pairs(acc) do table.insert(out, {id, ww}) end
			return out
		end

		local function buildWeights(WW, WH, us, vs, n)
			local WI, WV = table.create(n * 16, 1), table.create(n * 16, 0)
			for k = 1, n do
				local xs = cr1D(us[k] / WW * (PX - 1), PX)
				local ys = cr1D(vs[k] / WH * (PY - 1), PY)
				local o, s = (k - 1) * 16, 0
				for _, xa in ipairs(xs) do
					for _, ya in ipairs(ys) do
						s = s + 1
						WI[o + s] = ya[1] * PX + xa[1] + 1
						WV[o + s] = xa[2] * ya[2]
					end
				end
			end
			return {WI, WV, n}
		end

		local function evalList(R, wt, outX, outY)
			local WI, WV, n = wt[1], wt[2], wt[3]
			local px, py = R.px, R.py
			for k = 1, n do
				local o, x, y = (k - 1) * 16, 0, 0
				for s = 1, 16 do
					local w = WV[o + s]
					if w ~= 0 then
						local id = WI[o + s]
						x = x + w * px[id]; y = y + w * py[id]
					end
				end
				outX[k], outY[k] = x, y
			end
		end

		local function initNodes(R)
			local WW, WH = R.WW, R.WH
			R.rx, R.ry, R.px, R.py, R.vx, R.vy, R.ax, R.ay = {}, {}, {}, {}, {}, {}, {}, {}
			R.edges = {}
			for j = 0, PY - 1 do
				for i = 0, PX - 1 do
					local n = j * PX + i + 1
					R.rx[n], R.ry[n] = i * WW / (PX - 1), j * WH / (PY - 1)
					R.px[n], R.py[n], R.vx[n], R.vy[n], R.ax[n], R.ay[n] = R.rx[n], R.ry[n], 0, 0, 0, 0
				end
			end
			local rx, ry = R.rx, R.ry
			local function edge(a, b, w)
				local dx, dy = rx[b] - rx[a], ry[b] - ry[a]
				local lim = sqrt(dx * dx + dy * dy) * 0.32
				table.insert(R.edges, {a, b, dx, dy, w, 1 / (lim * lim)})
			end
			for j = 0, PY - 1 do
				for i = 0, PX - 1 do
					local n = j * PX + i + 1
					if i < PX - 1 then edge(n, n + 1, 1) end
					if j < PY - 1 then edge(n, n + PX, 1) end
					if i < PX - 1 and j < PY - 1 then
						edge(n, n + PX + 1, 0.5)
						edge(n + 1, n + PX, 0.5)
					end
				end
			end
		end

		local function resetNodes(R)
			for n = 1, NN do R.px[n], R.py[n], R.vx[n], R.vy[n] = R.winX + R.rx[n], R.winY + R.ry[n], 0, 0 end
		end

		local function physicsStep(R, h)
			local k, c = CFG.stiffness, CFG.damping
			local px, py, vx, vy, ax, ay, rx, ry = R.px, R.py, R.vx, R.vy, R.ax, R.ay, R.rx, R.ry
			for n = 1, NN do ax[n] = 0; ay[n] = 0 end
			for _, e in ipairs(R.edges) do
				local a, b = e[1], e[2]
				local dx = (px[b] - px[a]) - e[3]
				local dy = (py[b] - py[a]) - e[4]
				local m = (dx * dx + dy * dy) * e[6]
				if m > 8 then m = 8 end
				local kw = k * e[5] * (1 + m)
				ax[a] = ax[a] + dx * kw; ay[a] = ay[a] + dy * kw
				ax[b] = ax[b] - dx * kw; ay[b] = ay[b] - dy * kw
			end
			local g = R.grab
			if g then
				local gx, gy, gvx, gvy = 0, 0, 0, 0
				for q = 1, 4 do
					local n, w = g.n[q], g.w[q]
					gx = gx + w * px[n]; gy = gy + w * py[n]; gvx = gvx + w * vx[n]; gvy = gvy + w * vy[n]
				end
				local K_ = CFG.grab
				local Cg = 2 * sqrt(K_) * 0.55
				local fx = ((g.tx - gx) * K_ - gvx * Cg) / g.w2
				local fy = ((g.ty - gy) * K_ - gvy * Cg) / g.w2
				for q = 1, 4 do
					local n, w = g.n[q], g.w[q]
					ax[n] = ax[n] + fx * w; ay[n] = ay[n] + fy * w
				end
			end
			local hm = R.home
			if hm then
				for n = 1, NN do
					ax[n] = ax[n] + (hm.x + rx[n] - px[n]) * hm.k - vx[n] * hm.c
					ay[n] = ay[n] + (hm.y + ry[n] - py[n]) * hm.k - vy[n] * hm.c
				end
			end
			for n = 1, NN do
				vx[n] = vx[n] + (ax[n] - c * vx[n]) * h
				vy[n] = vy[n] + (ay[n] - c * vy[n]) * h
				px[n] = px[n] + vx[n] * h
				py[n] = py[n] + vy[n] * h
			end
			if CFG.collide then
				local VX, VY, e = R.VX, R.VY, CFG.restitution
				for n = 1, NN do
					if px[n] < 0 then px[n] = 0; if vx[n] < 0 then vx[n] = -vx[n] * e; vy[n] = vy[n] * 0.92 end
					elseif px[n] > VX then px[n] = VX; if vx[n] > 0 then vx[n] = -vx[n] * e; vy[n] = vy[n] * 0.92 end end
					if py[n] < 0 then py[n] = 0; if vy[n] < 0 then vy[n] = -vy[n] * e; vx[n] = vx[n] * 0.92 end
					elseif py[n] > VY then py[n] = VY; if vy[n] > 0 then vy[n] = -vy[n] * e; vx[n] = vx[n] * 0.92 end end
				end
			end
		end

		local function centroid(R)
			local sx, sy = 0, 0
			for n = 1, NN do sx = sx + R.px[n] - R.rx[n]; sy = sy + R.py[n] - R.ry[n] end
			return sx / NN, sy / NN
		end

		local function snapToRest(R)
			local cx, cy = centroid(R)
			R.winX, R.winY = floor(cx + 0.5), floor(cy + 0.5)
			if CFG.collide and R.VX > 0 then
				R.winX = clamp(R.winX, 0, max(0, R.VX - R.WW))
				R.winY = clamp(R.winY, 0, max(0, R.VY - R.WH))
			end
		end

		local function settleCheck(R)
			local ox, oy = centroid(R)
			local maxV, maxD = 0, 0
			for n = 1, NN do
				local v = R.vx[n] * R.vx[n] + R.vy[n] * R.vy[n]
				if v > maxV then maxV = v end
				local dx, dy = R.px[n] - R.rx[n] - ox, R.py[n] - R.ry[n] - oy
				local d = dx * dx + dy * dy
				if d > maxD then maxD = d end
			end
			local homeOk = not R.home or (abs(ox - R.home.x) < 0.6 and abs(oy - R.home.y) < 0.6)
			if maxV < 0.8 and maxD < 0.12 and homeOk then
				snapToRest(R); resetNodes(R)
				R.simulating, R.home = false, nil
				R.meshDirty, R.glassDirty = true, true
				return true
			end
			return false
		end

		---------------------------------------------------------------- projection + mesh updates
		local function projX(R, x, depth) return clamp((2 * x / R.VX - 1) * depth * V.tanH * (R.VX / R.VY), -7.9, 7.9) end
		local function projY(R, y, depth) return clamp((1 - 2 * y / R.VY) * depth * V.tanH, -7.9, 7.9) end

		local function updateWinMesh(R)
			evalList(R, R.wts.win, R.sxW, R.syW)
			local sh = R.winSheet
			local em, vids = sh.em, sh.vids
			local V3 = Vector3.new
			for k = 1, sh.n do
				em:SetPosition(vids[k], V3(projX(R, R.sxW[k], 1), projY(R, R.syW[k], 1), -1))
			end
		end

		-- the glass lives in the world camera's space, so screen px = local px + gui inset
		local function gProjX(x, depth, cvx, cvy) return clamp((2 * x / cvx - 1) * depth * V.tanH * (cvx / cvy), -7.9, 7.9) end
		local function gProjY(y, depth, cvy) return clamp((1 - 2 * y / cvy) * depth * V.tanH, -7.9, 7.9) end

		local function updateGlass(R)
			if not R.glassPart.Parent then return end
			evalList(R, R.wts.glass, R.gX, R.gY)
			local sh = R.glassSheet
			local em, vids, nF, nB = sh.em, sh.vids, sh.nF, sh.nB
			local amt = CFG.refract * 0.45
			local V3 = Vector3.new
			local cvx, cvy = V.cvx, V.cvy
			local gx_, gy_, gz_ = R.gx_, R.gy_, R.gz_
			for k = 1, sh.n do
				local depth = DG * (1 + amt * R.gProf[k])
				local wx, wy = gProjX(R.gX[k], depth, cvx, cvy), gProjY(R.gY[k] + V.insetY, depth, cvy)
				gx_[k], gy_[k], gz_[k] = wx, wy, -depth
				em:SetPosition(vids[k], V3(wx, wy, -depth))
			end
			local n1 = GRX + 1
			for j = 0, GRY do
				for i = 0, GRX do
					local k = j * n1 + i + 1
					local kl, kr = (i > 0) and k - 1 or k, (i < GRX) and k + 1 or k
					local ku, kd = (j > 0) and k - n1 or k, (j < GRY) and k + n1 or k
					local ux, uy, uz = gx_[kr] - gx_[kl], gy_[kr] - gy_[kl], gz_[kr] - gz_[kl]
					local wx, wy, wz = gx_[ku] - gx_[kd], gy_[ku] - gy_[kd], gz_[ku] - gz_[kd]
					local nx, ny, nz = uy * wz - uz * wy, uz * wx - ux * wz, ux * wy - uy * wx
					local l = sqrt(nx * nx + ny * ny + nz * nz)
					if l > 1e-9 then
						nx, ny, nz = nx / l, ny / l, nz / l
						em:SetNormal(nF[k], V3(nx, ny, nz))
						em:SetNormal(nB[k], V3(-nx, -ny, -nz))
					end
				end
			end
		end

		---------------------------------------------------------------- rig = per-window mesh state
		-- (re)computes everything that depends on the window size
		local function layoutRig(R, WW, WH)
			R.WW, R.WH = WW, WH
			R.TXW, R.TXH = (WW + 2 * MG) * SS, (WH + 2 * MG) * SS
			-- new texture (EditableImage size is fixed at creation)
			if R.winImg then pcall(function() R.winImg:Destroy() end) end
			R.winImg = AssetService:CreateEditableImage({Size = Vector2.new(R.TXW, R.TXH)})
			R.canvas = buffer.create(R.TXW * R.TXH * 4)
			drawBackground(R)
			R.winImg:WritePixelsBuffer(Vector2.zero, Vector2.new(R.TXW, R.TXH), R.canvas)
			R.canvas = nil -- free the 2.5 MB buffer, it is rebuilt on the next resize
			local mp = R.winSheet.mp
			local sa = mp:FindFirstChildOfClass("SurfaceAppearance")
			if sa then
				sa.ColorMapContent = Content.fromObject(R.winImg)
			else
				mp.TextureContent = Content.fromObject(R.winImg)
			end
			layoutSheet(R.winSheet, WW, WH)
			layoutSheet(R.glassSheet, WW, WH)
			R.gU, R.gV, R.gProf = {}, {}, {}
			local r = CFG.radius
			for k = 1, R.glassSheet.n do
				local u, v = R.glassSheet.us[k], R.glassSheet.vs[k]
				local cxr, cyr = clamp(u, r, WW - r), clamp(v, r, WH - r)
				local dx, dy = u - cxr, v - cyr
				local d = sqrt(dx * dx + dy * dy)
				if d > r and d > 0 then u, v = cxr + dx / d * r, cyr + dy / d * r end
				R.gU[k], R.gV[k] = u, v
				local p = 1 - clamp(-sdRound(u, v, 0, 0, WW, WH, r) / 34, 0, 1)
				R.gProf[k] = p * p
			end
			initNodes(R)
			R.wts = {
				win = buildWeights(WW, WH, R.winSheet.us, R.winSheet.vs, R.winSheet.n),
				glass = buildWeights(WW, WH, R.gU, R.gV, R.glassSheet.n),
			}
			R.sxW, R.syW, R.gX, R.gY = {}, {}, {}, {}
			R.gx_, R.gy_, R.gz_ = {}, {}, {}
			R.simulating, R.grab, R.home = false, nil, nil
			R.meshDirty, R.glassDirty = true, true
		end

		local function destroyRig(R)
			for _, o in ipairs({R.vf, R.glassPart, R.winImg, R.winSheet and R.winSheet.em, R.glassSheet and R.glassSheet.em}) do
				if o then pcall(function() o:Destroy() end) end
			end
			R.ready = false
		end

		local function buildRig(R)
			local win = R.window
			local sz = win.GuiElems.Main.AbsoluteSize
			local WW, WH = floor(sz.X + 0.5), floor(sz.Y + 0.5)
			local ok, err = pcall(function()
				local vf = Instance.new("ViewportFrame")
				vf.Name = "SkinViewport"
				vf.BackgroundTransparency = 1
				vf.Size = UDim2.fromScale(1, 1)
				vf.Ambient = Color3.new(1, 1, 1)
				vf.LightColor = Color3.new(0, 0, 0)
				vf.ZIndex = 1
				vf.Active = false
				vf.Visible = false
				vf.Parent = win.Gui
				R.vf = vf
				R.vcam = Instance.new("Camera")
				R.vcam.CFrame = CFrame.new()
				R.vcam.Parent = vf
				vf.CurrentCamera = R.vcam

				R.winSheet = newSheet(RX, RY, false)
				R.glassSheet = newSheet(GRX, GRY, true)
				layoutSheet(R.winSheet, WW, WH)
				layoutSheet(R.glassSheet, WW, WH)
				R.winSheet.mp = sheetPart(R.winSheet)
				R.glassSheet.mp = sheetPart(R.glassSheet)

				local mp = R.winSheet.mp
				local sa = useAlpha and trySA()
				if sa then sa.Parent = mp end
				mp.Material = Enum.Material.SmoothPlastic
				mp.Color = Color3.new(1, 1, 1)
				mp.Parent = vf

				local gp = R.glassSheet.mp
				gp.Material = Enum.Material.Glass
				gp.Name = "DexSkinGlass"
				gp.Color = C3(CFG.tint)
				gp.Reflectance = CFG.reflect
				R.glassPart = gp

				layoutRig(R, WW, WH)
			end)
			if not ok then
				warn("[BAD DEX Skin] mesh rig failed, using plain glass frame: " .. tostring(err))
				destroyRig(R)
				R.failed = true
				return false
			end
			R.winX, R.winY = 0, 0
			R.ready = true
			return true
		end

		---------------------------------------------------------------- chrome (title bar, traffic lights, fallback frame)
		local function mkLight(parent, color, x, glyph)
			local b = Instance.new("TextButton")
			b.Name = "SkinLight"
			b.AutoButtonColor = false
			b.Text = ""
			b.BorderSizePixel = 0
			b.BackgroundColor3 = C3(color)
			b.Size = UDim2.fromOffset(12, 12)
			b.Position = UDim2.fromOffset(x, 4)
			b.ZIndex = 5
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(1, 0)
			c.Parent = b
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Text = glyph
			t.TextSize = 11
			t.TextColor3 = Color3.fromRGB(60, 20, 10)
			t.TextTransparency = 1
			t.ZIndex = 6
			if FONT_MED then t.FontFace = FONT_MED end
			t.Parent = b
			b.MouseEnter:Connect(function() t.TextTransparency = 0.1 end)
			b.MouseLeave:Connect(function() t.TextTransparency = 1 end)
			b.Parent = parent
			return b
		end

		local function applyChrome(R)
			local win = R.window
			local e = win.GuiElems
			local main, bar = e.Main, e.TopBar
			-- fallback glass frame (visible whenever the mesh is not)
			local fb = Instance.new("Frame")
			fb.Name = "SkinFallback"
			fb.BorderSizePixel = 0
			fb.BackgroundColor3 = C3(ST.bg)
			fb.BackgroundTransparency = 0.35
			fb.Size = UDim2.fromScale(1, 1)
			fb.ZIndex = 0
			fb.Visible = false
			Instance.new("UICorner", fb).CornerRadius = UDim.new(0, CFG.radius)
			local st = Instance.new("UIStroke")
			st.Color = Color3.new(1, 1, 1)
			st.Thickness = 1
			st.Transparency = 0.25
			st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			st.Parent = fb
			local gr = Instance.new("UIGradient")
			gr.Rotation = 25
			gr.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.5, 0.8), NumberSequenceKeypoint.new(1, 0.1)})
			gr.Parent = st
			fb.Parent = main
			R.fallback = fb

			-- traffic lights (replace Dex's close / minimise images)
			R.lights = {}
			R.lights.close = mkLight(bar, ST.close, 6, "x")
			R.lights.min = mkLight(bar, ST.min, 22, "-")
			R.lights.center = mkLight(bar, ST.center, 38, "+")
			R.lights.close.MouseButton1Click:Connect(function()
				if win.Closed then return end
				win:Close()
			end)
			R.lights.min.MouseButton1Click:Connect(function()
				if win.Closed then return end
				if win.Aligned then win:SetAligned(false) else win:SetMinimized() end
			end)
			R.lights.center.MouseButton1Click:Connect(function()
				Skin.Center(win)
			end)
			for _, l in pairs(R.lights) do l.Visible = false end
			R.chromeOn = false
		end

		-- applies / removes the Skidnet look depending on the window mode (floating vs docked to a side)
		local function setChrome(R, on)
			if R.chromeOn == on then return end
			R.chromeOn = on
			local e = R.window.GuiElems
			for _, l in pairs(R.lights) do l.Visible = on end
			e.Close.Visible, e.Minimize.Visible = not on, not on
			if not on then
				e.Title.Position, e.Title.Size, e.Title.TextXAlignment = UDim2.new(0, 5, 0, 0), UDim2.new(1, -10, 0, 20), Enum.TextXAlignment.Left
				e.TopBar.BackgroundTransparency = 0
				e.Outlines.Visible = true
				R.fallback.Visible = false
				pcall(function()
					e.Title.Font = Enum.Font.SourceSans
					e.Title.TextSize = 14
					if R.origContent then e.Content.BackgroundColor3 = R.origContent end
				end)
				return
			end
			R.origContent = R.origContent or e.Content.BackgroundColor3
			e.Title.Position, e.Title.Size, e.Title.TextXAlignment = UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 20), Enum.TextXAlignment.Center
			e.Title.TextColor3 = C3(ST.text)
			if FONT_MED then e.Title.FontFace = FONT_MED end
			e.Title.TextSize = 13
			local cr = e.Main:FindFirstChildOfClass("UICorner")
			if cr then cr.CornerRadius = UDim.new(0, CFG.radius) end
			local cc = e.Content:FindFirstChildOfClass("UICorner") or Instance.new("UICorner", e.Content)
			cc.CornerRadius = UDim.new(0, max(CFG.radius, 4))
			e.Content.ClipsDescendants = true
			e.Content.BackgroundColor3 = C3(ST.bg)
			e.Main.ZIndex = 2
		end

		-- keeps properties that Dex's own code resets (e.g. Show() sets TopBar/Outlines back) in the skinned state
		local function syncChrome(R, meshOn)
			local e = R.window.GuiElems
			if R.chromeOn then
				if e.TopBar.BackgroundTransparency ~= 1 then e.TopBar.BackgroundTransparency = 1 end
				if e.Outlines.Visible then e.Outlines.Visible = false end
				local fbVisible = not meshOn and not R.window.Closed
				if R.fallback.Visible ~= fbVisible then R.fallback.Visible = fbVisible end
				if e.Close.Visible then e.Close.Visible = false end
				if e.Minimize.Visible then e.Minimize.Visible = false end
			end
		end

		---------------------------------------------------------------- pointer / grab
		local function pointer(R)
			local g = R.grab
			if g and g.touch and lastTouch then return lastTouch end
			local m = UIS:GetMouseLocation()
			return Vector2.new(m.X, m.Y - V.insetY)
		end

		local function rigOrigin(R)
			local vp = R.vf.AbsolutePosition
			local mp = R.window.GuiElems.Main.AbsolutePosition
			return mp.X - vp.X, mp.Y - vp.Y
		end

		---------------------------------------------------------------- per-frame
		local function poke(R, u, v, power)
			R.simulating = true
			for n = 1, NN do
				local dx, dy = R.rx[n] - u, R.ry[n] - v
				local d = sqrt(dx * dx + dy * dy) + 1
				local f = exp(-(d * d) / (2 * 120 * 120)) * (power or 620)
				R.vx[n] = R.vx[n] + dx / d * f; R.vy[n] = R.vy[n] + dy / d * f
			end
		end

		local function meshWanted(R)
			local win = R.window
			if not (Skin.Enabled and R.ready and not R.failed and not Skin.Hidden) then return false end
			if win.Closed or win.Aligned or win.Minimized or win.Resizing then return false end
			if not win.Gui.Parent then return false end
			return true
		end

		local function stepRig(R, dt)
			local win = R.window
			local main = win.GuiElems.Main
			if not R.chromeOn and not win.Aligned then setChrome(R, true) end
			if R.chromeOn and win.Aligned then setChrome(R, false) end

			local sz = main.AbsoluteSize

			-- lazy build (CreateMeshPartAsync yields, so it runs in its own thread)
			if not R.ready and not R.failed and not R.building and Skin.Enabled and not win.Closed and not win.Aligned
				and not win.Minimized and not win.Resizing and win.Gui.Parent and sz.X >= 80 and sz.Y >= 60
				and abs(sz.X - win.SizeX) < 1.5 and abs(sz.Y - win.SizeY) < 1.5 then
				R.building = true
				task.spawn(function()
					buildRig(R)
					R.building = false
				end)
			end

			if not R.ready then syncChrome(R, false) return end
			local sizeOk = floor(sz.X + 0.5) == R.WW and floor(sz.Y + 0.5) == R.WH
			local want = meshWanted(R)

			-- window got resized (Dex handle / tween): mesh is rebuilt once the size is stable
			if R.ready and not sizeOk and not win.Closed and not win.Aligned and not win.Minimized and not win.Resizing and sz.X > 80 and sz.Y > 60 then
				if R.lastSz ~= sz then R.lastSz = sz; R.sizeStable = 0 else R.sizeStable = (R.sizeStable or 0) + dt end
				if R.sizeStable > 0.2 and not R.busy then
					R.busy = true
					task.spawn(function()
						local ok, err = pcall(layoutRig, R, floor(sz.X + 0.5), floor(sz.Y + 0.5))
						if not ok then warn("[BAD DEX Skin] relayout failed: " .. tostring(err)) R.failed = true end
						R.winX, R.winY = 0, 0
						R.needSync = true
						R.busy = false
						R.lastSz, R.sizeStable = nil, 0
						R.popOnShow = true
					end)
				end
			elseif sizeOk then
				R.lastSz, R.sizeStable = nil, 0
			end
			if not sizeOk or R.busy then want = false end

			local meshOn = want
			if meshOn ~= R.meshOn then
				R.meshOn = meshOn
				R.vf.Visible = meshOn
				R.glassPart.Parent = (meshOn and useAlpha and Skin.UseGlass and cam) or nil
				R.meshDirty, R.glassDirty, R.needSync = true, true, true
				if meshOn and R.popOnShow then R.popOnShow = nil poke(R, R.WW / 2, R.WH / 2, 380) end
			end
			syncChrome(R, meshOn)
			if not meshOn then
				R.simulating, R.grab, R.home = false, nil, nil
				return
			end

			R.VX, R.VY = R.vf.AbsoluteSize.X, R.vf.AbsoluteSize.Y
			if R.VX < 1 or R.VY < 1 then return end

			if not R.simulating then
				-- follow Dex moving the window (tweens, MoveInBoundary, docking...)
				local ox, oy = rigOrigin(R)
				ox, oy = floor(ox + 0.5), floor(oy + 0.5)
				if R.needSync or ox ~= R.winX or oy ~= R.winY then
					R.needSync = false
					R.winX, R.winY = ox, oy
					resetNodes(R)
					R.meshDirty, R.glassDirty = true, true
				end
			else
				local hmax = min(MAX_H, 0.9 / sqrt(CFG.stiffness * 54 + CFG.grab * 4 + 1))
				local subs = max(1, ceil(dt / hmax))
				local h = dt / subs
				local g = R.grab
				if g then
					local p = pointer(R)
					g.tx, g.ty = p.X + g.ox, p.Y + g.oy
				end
				for _ = 1, subs do physicsStep(R, h) end
				R.meshDirty, R.glassDirty = true, true
				-- the real window (content) rides the centre of the jelly
				local cx, cy = centroid(R)
				main.Position = fromOffset(cx, cy)
				if not g then settleCheck(R) end
				if not R.simulating then main.Position = fromOffset(R.winX, R.winY) end
			end

			if R.meshDirty then
				R.meshDirty = false
				R.vcam.FieldOfView = V.fov
				updateWinMesh(R)
			end
			if R.glassPart.Parent then
				R.glassPart.Transparency = 1 - (1 - CFG.glassTransp)
				R.glassPart.CFrame = cam.CFrame
				if R.glassDirty then
					R.glassDirty = false
					updateGlass(R)
				end
			end
		end

		---------------------------------------------------------------- public: drag hooks used by Lib.Window
		-- true when the mesh rig took over this window's drag (Dex then must NOT set Main.Position itself)
		function Skin.DragBegin(win)
			local R = rigs[win]
			if not R or not R.meshOn or not CFG.jellyClick then return false end
			local p = UIS:GetMouseLocation()
			local lp = Vector2.new(p.X, p.Y - V.insetY)
			local touch = false
			R.VX, R.VY = R.vf.AbsoluteSize.X, R.vf.AbsoluteSize.Y
			if not R.simulating then
				local ox, oy = rigOrigin(R)
				R.winX, R.winY = floor(ox + 0.5), floor(oy + 0.5)
				resetNodes(R)
			end
			local cx, cy = centroid(R)
			local u = clamp(lp.X - cx, 0, R.WW)
			local v = clamp(lp.Y - cy, 0, R.WH)
			local fu = clamp(u / R.WW * (PX - 1), 0, PX - 1 - 1e-6)
			local fv = clamp(v / R.WH * (PY - 1), 0, PY - 1 - 1e-6)
			local i, j = floor(fu), floor(fv)
			local tx, ty = fu - i, fv - j
			local n0 = j * PX + i + 1
			local g = {n = {n0, n0 + 1, n0 + PX, n0 + PX + 1}, w = {(1 - tx) * (1 - ty), tx * (1 - ty), (1 - tx) * ty, tx * ty}, touch = touch}
			local gx, gy, w2 = 0, 0, 0
			for q = 1, 4 do
				gx = gx + g.w[q] * R.px[g.n[q]]; gy = gy + g.w[q] * R.py[g.n[q]]
				w2 = w2 + g.w[q] * g.w[q]
			end
			g.w2, g.ox, g.oy, g.tx, g.ty = w2, gx - lp.X, gy - lp.Y, gx, gy
			R.grab, R.home, R.simulating = g, nil, true
			return true
		end

		function Skin.Drag(win)
			local R = rigs[win]
			return R ~= nil and R.grab ~= nil
		end

		function Skin.DragEnd(win)
			local R = rigs[win]
			if R then R.grab = nil end
		end

		-- docking etc.: stop the jelly and let Dex place the window
		function Skin.Cancel(win)
			local R = rigs[win]
			if not R then return end
			R.grab, R.home = nil, nil
			if R.simulating then
				snapToRest(R)
				R.simulating = false
				win.GuiElems.Main.Position = fromOffset(R.winX, R.winY)
			end
		end

		function Skin.Center(win)
			local R = rigs[win]
			if not R or not R.meshOn then
				local main = win.GuiElems.Main
				local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
				main.Position = UDim2.fromOffset(floor(vs.X / 2 - win.SizeX / 2), floor(vs.Y / 2 - win.SizeY / 2))
				return
			end
			local ox, oy = rigOrigin(R)
			R.winX, R.winY = floor(ox + 0.5), floor(oy + 0.5)
			if not R.simulating then resetNodes(R) end
			R.simulating = true
			R.grab = nil
			R.home = {x = floor(R.VX / 2 - R.WW / 2), y = floor(R.VY / 2 - R.WH / 2), k = 60, c = 7}
		end

