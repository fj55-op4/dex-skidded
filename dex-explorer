		local deobbtn = Instance.new("TextButton",window.GuiElems.Content)
		deobbtn.BackgroundTransparency = 1
		deobbtn.Size = UDim2.new(0.34,0,0,20)
		deobbtn.Position = UDim2.new(0.33,0,1,-20)
		deobbtn.Text = "Deobfuscate"
		deobbtn.TextColor3 = Color3.new(1,1,1)
		deobbtn.MouseButton1Click:Connect(function()
			local scr = LastScr or PreviousScr
			if not scr then
				codeFrame:SetText("-- BAD DEX: open a script first (View Script), then press Deobfuscate.")
				return
			end
			codeFrame:SetText("-- BAD DEX: deobfuscating "..tostring(scr).." ...\n-- (first run loads the engine, can take a few seconds)")
			task.spawn(function()
				local __sti = setthreadidentity or setthreadcontext or setidentity or (syn and syn.set_thread_identity)
				local __gti = getthreadidentity or getthreadcontext or getidentity or (syn and syn.get_thread_identity)
				local __oldid = 8
				if __gti then local okg, v = pcall(__gti) if okg and type(v) == "number" then __oldid = v end end
				if __sti then pcall(__sti, 2) end
				local out
				local okAll, err = pcall(function()
					local deob = env.getDeob()
					if type(deob) ~= "function" then error("deob engine failed to load", 0) end
					local getc = getscriptclosure or getscriptfunction or env.getscriptclosure
					if not getc then error("getscriptclosure is not available in this executor", 0) end
					local fn = getc(scr)
					if type(fn) ~= "function" then error("couldn't get script closure (not a client script / no stored bytecode)", 0) end
					out = deob(fn, { debug = true, yield = true, mul = 6 })
				end)
				if __sti then pcall(__sti, __oldid) end
				if not okAll then
					codeFrame:SetText("-- BAD DEX: "..tostring(err))
				else
					codeFrame:SetText(out or "-- BAD DEX: no output")
				end
			end)
		end)
	end
	
	ScriptViewer.ViewScript = function(scr)
		LastScr = scr
		local oldtick = tick()
		local s,source = pcall(env.decompile or function() end,scr)

		if not s or not source then
			PreviousScr = nil
			dumpbtn.TextColor3 = Color3.new(0.5,0.5,0.5)
			source = "-- Unable to view source.\n"
			
			if Settings.ScriptViewer.ShowMoreInfo then
				source = source .. "-- Script Path: "..getPath(scr).."\n"
				if (scr.ClassName == "Script" and (scr.RunContext == Enum.RunContext.Legacy or scr.RunContext == Enum.RunContext.Server)) or not scr:IsA("LocalScript") then
					source = source .. "-- Reason: The script is not running on client. (attempt to decompile ServerScript or 'Script' with RunContext Server)\n"
				elseif not env.isdecompile() then
					source = source .. "-- Reason: Your executor does not support decompiler. (missing 'decompile' function and 'getscriptbytecode' function as fallback)\n"
				else
					source = source .. "-- Reason: Unknown Error.\n"
				end
				source = source .. "-- Executor: "..executorName.." ("..executorVersion..")"
			end
		else
			PreviousScr = scr
			dumpbtn.TextColor3 = Color3.new(1,1,1)

			local decompiled = source

			source = "-- Script Path: "..getPath(scr).."\n"
			
			if Settings.ScriptViewer.ShowMoreInfo then
				source = source .. "-- Took "..tostring(math.floor( (tick() - oldtick) * 100) / 100).."s to decompile.\n"
				source = source .. "-- Executor: "..executorName.." ("..executorVersion..")\n\n"
			end
			
			source = source .. decompiled

			oldtick = nil
			decompiled = nil
		end

		codeFrame:SetText(source)
		window:Show()
	end

	ScriptViewer.SetCurrent = function(scr)
		LastScr = scr
	end

	ScriptViewer.ViewSource = function(text)
		codeFrame:SetText(text or "")
		window:Show()
	end

	return ScriptViewer
end

