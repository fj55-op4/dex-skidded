				if not oka or type(packed) ~= "table" then
					RC.res.TextColor3 = Color3.fromRGB(235,120,120)
					RC.res.Text = "arg error: "..tostring(packed)
					return
				end
				local out = table.pack(pcall(function()
					return target[m](target, table.unpack(packed, 1, packed.n))
				end))
				if not out[1] then
					RC.res.TextColor3 = Color3.fromRGB(235,120,120)
					RC.res.Text = "error: "..tostring(out[2])
				else
					RC.res.TextColor3 = Color3.fromRGB(150,220,150)
					if out.n > 1 then
						local parts = {}
						for i = 2, out.n do parts[#parts+1] = tostring(out[i]) end
						RC.res.Text = m.." -> "..table.concat(parts, ",  ")
					else
						RC.res.Text = m.." fired successfully"
					end
				end
			end)
		end
		RC.win:SetTitle("Remote Caller - "..obj.Name)
		RC.info.Text = obj.ClassName.."  :  "..method.."( ... )      args as Lua, comma-separated"
		RC.res.Text = ""
		RC.box:CaptureFocus()
		RC.win:Show()
	end

	Explorer.remoteSpyTargets = Explorer.remoteSpyTargets or {}
	Explorer.remoteSpyLog = Explorer.remoteSpyLog or {}
	local rsInstalled = false
	local function rsFormatArgs(...)
		local n = select("#", ...)
		local parts = {}
		for i = 1, n do parts[i] = tostring((select(i, ...))) end
		return table.concat(parts, ", ")
	end
	local function installRemoteSpy()
		if rsInstalled or not env.hookmetamethod then return end
		rsInstalled = true
		local getncm = getnamecallmethod
		local old
		old = env.hookmetamethod(game, "__namecall", function(self, ...)
			local m
			if getncm then local ok, r = pcall(getncm) if ok then m = r end end
			if Explorer.remoteSpyTargets[self] and (m == "FireServer" or m == "InvokeServer" or m == "Fire" or m == "Invoke") then
				local line = ("[%s] %s:%s(%s)"):format(os.date("%X"), tostring(self.Name), tostring(m), rsFormatArgs(...))
				table.insert(Explorer.remoteSpyLog, 1, line)
				Explorer.remoteSpyLog[301] = nil
				pcall(print, "[BAD DEX SPY] "..line)
			end
			return old(self, ...)
		end)
	end
	Explorer.ToggleRemoteSpy = function(obj)
		if not obj then return end
		if Explorer.remoteSpyTargets[obj] then
			Explorer.remoteSpyTargets[obj] = nil
		else
			Explorer.remoteSpyTargets[obj] = true
			installRemoteSpy()
		end
	end
	Explorer.ShowRemoteSpyLog = function()
		local log = Explorer.remoteSpyLog
		if #log == 0 then
			ScriptViewer.ViewSource("-- BAD DEX Remote Spy: no calls captured yet.\n-- Right-click a remote -> Spy Remote (toggle), then trigger it in-game.")
		else
			ScriptViewer.ViewSource("-- BAD DEX Remote Spy log (newest first):\n\n"..table.concat(log, "\n"))
		end
	end

